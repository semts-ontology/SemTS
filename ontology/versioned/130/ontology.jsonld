      "@id": "semts:outputKnowledge",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Opposed to Input Knowledge, this property defines the knowledge included in the output of a Knowledge generation Entity.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:KnowledgeGenerationOutput"
