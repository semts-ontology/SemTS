      "@id": "semts:metBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Allen’s interval algebra relation 'metBy' (OWL-Time time:intervalMetBy). Inverse of :meets. For TimeSeriesSegment individuals, inferable via :segmentIndex: A starts exactly when B ends.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
