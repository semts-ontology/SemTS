        "owl:ObjectProperty",
        "owl:TransitiveProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines a hierarchic relationship between time series segments. The intuition of this property is to differentiate between complete time series, in a sense that it includes the data from start to end and subsegments which are reduced in time or dimensionality and thus can be considered a slice of this original data.",
          "@language": "en"
