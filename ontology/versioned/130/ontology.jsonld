        },
        {
          "@id": "https://www.w3.org/TR/vocab-dcat-3/"
        }
      ],
      "dcterms:rights": [
        {
          "@value": "CC BY 4.0",
          "@language": "en"
        }
      ],
      "dcterms:title": [
        {
          "@value": "The Semantic Time Series Ontology"
        }
      ],
      "vann:preferredNamespacePrefix": [
        {
          "@value": "semts"
        }
      ],
      "vann:preferredNamespaceUri": [
        {
          "@value": "https://w3id.org/semts/ontology#"
        }
      ],
