      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Allen’s interval algebra relation 'finishedBy' (OWL-Time time:intervalFinishedBy). Inverse of :finishes. For TimeSeriesSegment individuals, inferable via :segmentIndex: A is finished by B, both end together and B starts before A.",
          "@language": "en"
