    {
      "@id": "semts:Algorithm",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Refers to any algorithmic solution in the context of time series analysis. While this class extends the mls:Algorithm class, it enables a reference to further details on specific task specifics and experiments. It is considered method knowledge as this class can be used to define knowledge about an appropriate or optimal algorithmic solution associated with a time series segment.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Algorithm Recommendation",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "mls:Algorithm"
        },
        {
          "@id": "semts:MethodKnowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:Hyperparameter"
        }
      ]
    },
    {
      "@id": "semts:ArtificialTimeSeriesSegment",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "A time series segment that does not, or only partially refer to concrete time series data. It represents an artificially generated time series segment that might for instance describe the result of a forecast with a time index not being in the range of the original time series data.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Artificial Time Series Segment",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b1"
        },
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ]
    },
    {
      "@id": "semts:CommonContextKnowledge",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Knowledge that represents contextual information whose proposition is not intrinsically scoped to a particular TimeSeriesSegment or a particular set of segments. It may nevertheless be associated with selected segments through commonContextKnowledge. The class is not disjoint with DataKnowledge, ScenarioKnowledge, or MethodKnowledge. Whenever this type is present, segment association must still use commonContextKnowledge rather than segmentKnowledge or multiSegmentKnowledge.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Common Context Knowledge",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b2"
        },
        {
          "@id": "_:b3"
        },
        {
          "@id": "_:b4"
        },
        {
          "@id": "semts:Knowledge"
        }
      ]
    },
    {
      "@id": "semts:DataDimension",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines a data dimension (or also referred to as feature or attribute) in a time series segment.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Data Dimension",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "semts:DataKnowledge",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines knowledge derived from data. This includes statistics, signal characteristics, and knowledge generated through data-analysis methods, such as predictions, anomalies, or cluster memberships.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Data Knowledge",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b5"
        },
        {
          "@id": "semts:Knowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:KnowledgeGroup"
        },
        {
          "@id": "semts:MethodKnowledge"
        },
        {
          "@id": "semts:ScenarioKnowledge"
        }
      ]
    },
    {
      "@id": "semts:DirectedKnowledgeRelation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "A KnowledgeRelation with one or more source Knowledge instances and one or more target Knowledge instances. Its semantic meaning is supplied through knowledgeConcept.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Directed Knowledge Relation",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b6"
        },
        {
          "@id": "_:b7"
        },
        {
          "@id": "semts:KnowledgeRelation"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:UndirectedKnowledgeRelation"
        }
      ]
    },
    {
      "@id": "semts:EmbeddedValue",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Refers to a value that is directly stored in the knowledge graph. Compared to referenced values, these values are rather single, non-complex values having a primitive type.\nOne example could be the mean value of a univariate time series.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Embedded Value",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b8"
        },
        {
          "@id": "semts:Value"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:ReferencedValue"
        }
      ]
    },
    {
      "@id": "semts:Hyperparameter",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "A hyperparameter is considered method knowledge as this class can be used to define knowledge about an appropriate or optimal hyperparameter setting associated with the analysis of a time series segment for a concrete task.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Parameter Recommendation",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "mls:Hyperparameter"
        },
        {
          "@id": "semts:MethodKnowledge"
        }
      ]
    },
    {
      "@id": "semts:Knowledge",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Represents the highest level of any knowledge associated with time series data. Knowledge can be made more specific via subclasses or associated concepts.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b9"
        },
        {
          "@id": "_:b10"
        },
        {
          "@id": "_:b11"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeComparisonMeasure",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Any knowledge that is generated by a comparison of compatible inputs. This might either be raw data or already defined knowledge. A simple example might be the result of a Euclidean distance.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Comparison Measure",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "semts:KnowledgeGenerationEntity"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeConcept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "An SKOS concept associated with the knowledge class or any corresponding subclass",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Concept",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b12"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGenerationConcept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "An SKOS concept associated with the knowledge generation entity class or any corresponding subclass",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Generation Concept",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "skos:Concept"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGenerationEntity",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Represents the highest entity to define the process of knowledge generation. A more specific description can be provided by subclasses or assigned concepts. This class inherits from prov:Activity and thus allows for provenance during knowledge propagation.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Generation Entity",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b13"
        },
        {
          "@id": "_:b14"
        },
        {
          "@id": "_:b15"
        },
        {
          "@id": "prov:Activity"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGenerationIO",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines any input and output of a knowledge generation entity. It inherits from prov:Entity to define instances that are used by or generated by a prov:Activity, which in turn is the parental class of a knowledge generation entity.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Generation IO",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "prov:Entity"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGenerationInput",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines the input of a knowledge generation entity. While outputs can only contain produced knowledge, inputs might either reference knowledge or raw data.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Generation Input",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b16"
        },
        {
          "@id": "semts:KnowledgeGenerationIO"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:KnowledgeGenerationOutput"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGenerationMethod",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines a knowledge generation entity, which corresponds to method-based solution. Compared to other knowledge generation entities this class is a subclass of mls:Implementation and thus can be linked to algorithmic details.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Generation Method",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "mls:Implementation"
        },
        {
          "@id": "semts:KnowledgeGenerationEntity"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGenerationOutput",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines the output of a knowledge generation entity. Compared to inputs, outputs only allow for a reference to generated knowledge and not to raw data. This, on purpose, excludes data transformations from the overall ontology concept by only focusing on a propagation of knowledge.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Generation Output",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b17"
        },
        {
          "@id": "_:b18"
        },
        {
          "@id": "_:b19"
        },
        {
          "@id": "semts:KnowledgeGenerationIO"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeGroup",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "A grouping of knowledge which itself is again considered knowledge. Can be used to structure knowledge and create hierarchies.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Group",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b20"
        },
        {
          "@id": "semts:Knowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:MethodKnowledge"
        },
        {
          "@id": "semts:ScenarioKnowledge"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeQualityMeasure",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines the goodness or confidence of time series knowledge associated with one or multiple segments. For knowledge produced by a knowledge generation method the quality measure is often equal to the evaluation metric of the generation method, which is why this class inherits from mls:EvaluationMeasure.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Quality Measure",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b21"
        },
        {
          "@id": "_:b22"
        },
        {
          "@id": "mls:EvaluationMeasure"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeReasoning",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "To complement any knowledge that is generated via analytical methods, this class represents knowledge generated from reasoning processes. This also includes validation processes from human experts or results from reasoning tools.\nWhile many analysis results can be regarded unvalidated predictions, this class defines subsequent evaluations to further derive concrete facts or confirmations.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Reasoning",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "semts:KnowledgeGenerationEntity"
        }
      ]
    },
    {
      "@id": "semts:KnowledgeRelation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Abstract Knowledge superclass for a semantic relationship among Knowledge instances. It is not intended for direct instantiation: every relation individual is directed or undirected. Relation meanings are expressed by a KnowledgeConcept from any suitable vocabulary. The core ontology imposes no fixed relation concept scheme.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Knowledge Relation",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "semts:Knowledge"
        }
      ],
      "owl:equivalentClass": [
        {
          "@id": "_:b23"
        }
      ]
    },
    {
      "@id": "semts:MethodKnowledge",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Any knowledge that defines an appropriate setting, regarding a particular method that is beneficial or even optimal when analyzing a segment given a particular task.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Method Knowledge",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b24"
        },
        {
          "@id": "semts:Knowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:ScenarioKnowledge"
        }
      ]
    },
    {
      "@id": "semts:ModelInstance",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "This class describes a trained model in the traditional machine learning sense. It inherits from mls:Model and serves as a knowledge entity for subsequent predictions.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Model Instance",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b25"
        },
        {
          "@id": "mls:Model"
        },
        {
          "@id": "semts:DataKnowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:SegmentDataCharacteristic"
        },
        {
          "@id": "semts:SegmentPrediction"
        },
        {
          "@id": "semts:SegmentRelation"
        }
      ]
    },
    {
      "@id": "semts:QualityMeasureConcept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "An SKOS concept associated with the quality measure class",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Quality Measure Concept",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "skos:Concept"
        }
      ]
    },
    {
      "@id": "semts:ReferencedValue",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Refers to a value that is of arbitrary complexity and not directly stored in the knowledge graph. This class inherits from dcat:Resource and can be retrieved by the associated metadata. Dataset-valued resources may additionally be typed as dcat:Dataset. Examples include documents, models, images, fragments, or generated shapelet collections.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Referenced Value",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "dcat:Resource"
        },
        {
          "@id": "semts:Value"
        }
      ]
    },
    {
      "@id": "semts:ScenarioKnowledge",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines any knowledge that is associated with a particular scenario or domain. Scenario knowledge corresponds to validated expert knowledge or scenario-specific facts. It includes simple notes, predefined labels or mathematical expressions describing the underlying time series data.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Scenario Knowledge",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b26"
        },
        {
          "@id": "semts:Knowledge"
        }
      ]
    },
    {
      "@id": "semts:SegmentDataCharacteristic",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines analytical, data-specific insights including derived statistics or other structural characteristics such as representative kernel expressions. Knowledge of this class mostly equals extracted data features.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Segment Data Characteristic",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "semts:DataKnowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:SegmentPrediction"
        },
        {
          "@id": "semts:SegmentRelation"
        }
      ]
    },
    {
      "@id": "semts:SegmentPrediction",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines knowledge derived from data-driven analyses. This for instance includes anomalies and predictions.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Segment Prediction",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "semts:DataKnowledge"
        }
      ],
      "owl:disjointWith": [
        {
          "@id": "semts:SegmentRelation"
        }
      ]
    },
    {
      "@id": "semts:SegmentRelation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Defines knowledge that relates multiple segments, for example through cross-correlation or a distance measure.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Segment Relation",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b27"
        },
        {
          "@id": "semts:DataKnowledge"
        }
      ]
    },
    {
      "@id": "semts:TimeSeriesSegment",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "Represents a segment, also referred to as a slice, of a univariate or multivariate time series. A segment may cover the complete time series, a subinterval restricted to selected dimensions, or a single data point. The class inherits from dcat:Dataset and identifies its temporal index, represented data dimensions, distributions, and associated knowledge.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Time Series Segment",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b28"
        },
        {
          "@id": "_:b29"
        },
        {
          "@id": "dcat:Dataset"
        }
      ]
    },
    {
      "@id": "semts:UndirectedKnowledgeRelation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "A KnowledgeRelation with at least two unordered Knowledge participants. It does not use the directed source or target roles. Its semantic meaning is supplied through knowledgeConcept.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Undirected Knowledge Relation",
          "@language": "en"
        }
      ],
      "rdfs:subClassOf": [
        {
          "@id": "_:b30"
        },
        {
          "@id": "_:b31"
        },
        {
          "@id": "_:b32"
        },
        {
          "@id": "semts:KnowledgeRelation"
        }
      ]
    },
    {
      "@id": "semts:Value",
      "@type": [
        "owl:Class"
      ],
      "rdfs:comment": [
        {
          "@value": "This abstract class serves as parental class of EmbeddedValue and ReferencedValue.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Value",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "semts:after",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Allen’s interval algebra relation 'after' (OWL-Time time:intervalAfter). Inverse of :before. For TimeSeriesSegment individuals, this can be inferred from their :segmentIndex: A starts after B ends.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
        {
          "@value": "after",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "owl:inverseOf": [
        {
          "@id": "semts:before"
        }
      ],
      "owl:propertyChainAxiom": [
        {
          "@id": "_:b33"
        }
      ],
      "semts:correspondingOwlTimeRelation": [
        {
          "@id": "time:intervalAfter"
        }
      ]
    },
    {
      "@id": "semts:before",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Allen’s interval algebra relation 'before' (OWL-Time time:intervalBefore). For TimeSeriesSegment individuals, this can be inferred from their :segmentIndex temporal entities: A ends before B starts.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
        {
          "@value": "before",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "owl:propertyChainAxiom": [
        {
          "@id": "_:b34"
        }
      ],
      "semts:correspondingOwlTimeRelation": [
        {
          "@id": "time:intervalBefore"
        }
      ]
    },
    {
      "@id": "semts:commonContextKnowledge",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Associates a TimeSeriesSegment with CommonContextKnowledge that is contextually relevant under the segment conditions without asserting that the knowledge proposition is directly scoped to the segment.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
        {
          "@value": "common context knowledge",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "semts:CommonContextKnowledge"
        }
      ],
      "owl:propertyDisjointWith": [
        {
          "@id": "semts:multiSegmentKnowledge"
        },
        {
          "@id": "semts:segmentKnowledge"
        }
      ]
    },
    {
      "@id": "semts:contains",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Allen’s interval algebra relation 'contains' (OWL-Time time:intervalContains). Inverse of :during. For TimeSeriesSegment individuals, inferable via :segmentIndex: A fully contains B.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
        {
          "@value": "contains",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "owl:inverseOf": [
        {
          "@id": "semts:during"
        }
      ],
      "owl:propertyChainAxiom": [
        {
          "@id": "_:b35"
        }
      ],
      "semts:correspondingOwlTimeRelation": [
        {
          "@id": "time:intervalContains"
        }
      ]
    },
    {
      "@id": "semts:correspondingOwlTimeRelation",
      "@type": [
        "owl:AnnotationProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Links a SemTS Allen relation to the OWL-Time interval relation between segment indexes from which it follows through its property chain. The SemTS relations are deliberately not sub-properties of the OWL-Time relations: segments are datasets, not temporal intervals. Because the OWL-Time relations are defined for proper intervals, the SemTS Allen relations apply to segments whose index is a bounded time:Interval, not a time:Instant.",
          "@language": "en"
        }
      ],
      "rdfs:label": [
        {
          "@value": "corresponding OWL-Time relation",
          "@language": "en"
        }
      ]
    },
    {
      "@id": "semts:datasetColumnIndex",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Specifies the column index of a time series segment within a data file or database, in case a source contains multiple time series (e.g. nested dataframes).",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
        {
          "@value": "column index",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "_:b36"
        }
      ]
    },
    {
      "@id": "semts:datasetRowIndex",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Specifies the row index of a time series segment within a data file or database, in case a source contains multiple time series (e.g. nested dataframes).",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
        {
          "@value": "row index",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "_:b37"
        }
      ]
    },
    {
      "@id": "semts:description",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Can be used to optionally add a description to an entity of the domain.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "_:b38"
        }
      ],
      "rdfs:label": [
        {
          "@value": "description",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "xsd:string"
        }
      ],
      "rdfs:seeAlso": [
        {
          "@id": "dcterms:description"
        }
      ],
      "rdfs:subPropertyOf": [
        {
          "@id": "owl:topDataProperty"
        }
      ]
    },
    {
      "@id": "semts:dimensionPosition",
      "@type": [
        "owl:DatatypeProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Specifies the position of the associated dimension within a dataframe or similar ordered data structures.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:DataDimension"
        }
      ],
      "rdfs:label": [
        {
          "@value": "dimension position",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "_:b39"
        }
      ],
      "rdfs:subPropertyOf": [
        {
          "@id": "owl:topDataProperty"
        }
      ]
