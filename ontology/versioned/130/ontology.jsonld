        }
      ]
    },
    {
      "@id": "semts:multiSegmentKnowledge",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:comment": [
        {
          "@value": "Relates each member of a jointly considered set of at least two time-series segments to the same Knowledge individual, where the proposition is meaningful or valid only with respect to that segment set collectively and cannot be represented as independent knowledge assertions for its individual members. Generation inputs are provenance and do not by themselves determine this collective scope.",
          "@language": "en"
        }
      ],
      "rdfs:domain": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "rdfs:label": [
