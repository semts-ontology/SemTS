        }
      ],
      "rdfs:label": [
        {
          "@value": "overlaps",
          "@language": "en"
        }
      ],
      "rdfs:range": [
        {
          "@id": "semts:TimeSeriesSegment"
        }
      ],
      "owl:propertyChainAxiom": [
        {
          "@id": "_:b50"
        }
      ],
