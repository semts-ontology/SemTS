@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix semts: <https://w3id.org/semts/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:abstract a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:references a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:example a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

dc:contributor a owl:AnnotationProperty .

foaf:depiction a owl:AnnotationProperty .

foaf:image a owl:AnnotationProperty .

foaf:logo a owl:AnnotationProperty .

foaf:maker a owl:AnnotationProperty .

foaf:mbox a owl:AnnotationProperty .

foaf:name a owl:AnnotationProperty .

foaf:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> .

schema:citation a owl:AnnotationProperty .

semts: a owl:Ontology ;
    rdfs:label "Semantic Time Series"@en ;
    dc:contributor "Christian Beecks"@en,
        "Christoph Lange-Bever"@en,
        "Diego Collarana"@en,
        "Rohit A. Deshmukh"@en,
        "Stefan Decker"@en ;
    dcterms:abstract "SemTS is an ontology to semantically structure insights gained from multivariate time series analyses combined with domain-specific information. The concept of SemTS constitutes a specification of informative data points or intervals within time series data, further referred to as segments. Any segment comprises characteristic knowledge associated with the covered time interval. Examples of such knowledge range from common time series features and structural particularities, such as anomalies or motifs, to a priori information provided by domain experts. A classification and semantic representation of this knowledge enables organized reusability and effective propagation."@en ;
    dcterms:bibliographicCitation "Graß, A., Deshmukh, R. A., Lange, C., Collarana, D., Beecks, C., Decker, S. (2026). SemTS: Ontology and Vocabularies for the Semantic Categorization of Time Series Knowledge. In: The Semantic Web. 23rd European Semantic Web Conference, ESWC 2026, Proceedings, Part II. Lecture Notes in Computer Science, vol. 16550, pp. 172-190. Springer, Cham. https://doi.org/10.1007/978-3-032-25159-6_10"@en ;
    dcterms:created "2024-12-13"^^xsd:date ;
    dcterms:creator <https://w3id.org/semts/agent/alexander-grass> ;
    dcterms:description "SemTS is an ontology designed to identify and describe segments within time series data, which are specific data points or intervals that can overlap. These segments encompass characteristic knowledge about the time interval they cover, including common time series features, structural anomalies, motifs, or information provided by domain experts. By classifying and semantically representing this knowledge, SemTS promotes organized reusability and efficient propagation, potentially reducing resource expenditure while enhancing future analyses. It employs established semantic approaches. Examples are DCAT to reference associated time series data, OWL-Time to define the index structure of time series data and segments or ML-Schema to expand the expressiveness regarding data analysis task information. SemTS's design involves categorizing time series knowledge and mapping it to specific intervals and dimensions of time series data. It introduces a class called TimeSeriesSegment to model these segments, extending the DCAT Dataset class to enable segments to be part of other segments. This structure allows for the association of knowledge, such as anomalies, with particular intervals or data points. Temporal indexes reuse OWL-Time temporal entities, while dimensional details are represented by DataDimension. Concepts for knowledge, generation and quality are provided by modular SKOS vocabularies: a stable core per knowledge area plus extension modules. The segment-wise consideration of knowledge indirectly serves as an index structure, linking meaningful time series data with categorized knowledge. At the highest level of abstraction, time series knowledge is divided into three categories: DataKnowledge, ScenarioKnowledge, and MethodKnowledge. DataKnowledge refers to insights extracted directly from the data or through analytical methods, such as class membership from time series clustering. ScenarioKnowledge describes verified contexts, including data annotations or domain-specific process knowledge, often equating to expert-provided a priori information and can also define facts derived from inferred knowledge. MethodKnowledge encompasses effective analytical method presets or mathematical/logical equivalents of established process information. Knowledge groups and knowledge relations organise and connect knowledge items of all three categories, and common context knowledge holds for a machine, a process or a site rather than for a stretch of data."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-18"^^xsd:date ;
    dcterms:publisher <https://w3id.org/semts/agent/alexander-grass> ;
    dcterms:references <https://ml-schema.github.io/documentation/>,
        <https://www.qudt.org/doc/DOC_SCHEMA-QUDT.html>,
        <https://www.w3.org/TR/owl-time/>,
        <https://www.w3.org/TR/prov-o/>,
        <https://www.w3.org/TR/skos-reference/>,
        <https://www.w3.org/TR/vocab-dcat-3/> ;
    dcterms:rights "CC BY 4.0"@en ;
    dcterms:title "The Semantic Time Series Ontology" ;
    vann:preferredNamespacePrefix "semts" ;
    vann:preferredNamespaceUri "https://w3id.org/semts/ontology#" ;
    owl:imports <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/dcat>,
        <http://www.w3.org/ns/prov-o#> ;
    owl:priorVersion <https://w3id.org/semts/ontology/120#> ;
    owl:versionIRI <https://w3id.org/semts/ontology/130#> ;
    owl:versionInfo "1.3.0" ;
    foaf:depiction <https://raw.githubusercontent.com/semts-ontology/SemTS/refs/heads/main/assets/images/semts_architecture_1.3.0.svg> ;
    foaf:logo <https://raw.githubusercontent.com/semts-ontology/SemTS/78047e27e691f5ac7878d93bec2f25ab514bd06d/assets/images/logo.png> ;
    foaf:maker <https://w3id.org/semts/agent/alexander-grass> ;
    schema:citation <https://doi.org/10.1007/978-3-032-25159-6_10> .

semts:Algorithm a owl:Class ;
    rdfs:label "Algorithm Recommendation"@en ;
    rdfs:comment "Refers to any algorithmic solution in the context of time series analysis. While this class extends the mls:Algorithm class, it enables a reference to further details on specific task specifics and experiments. It is considered method knowledge as this class can be used to define knowledge about an appropriate or optimal algorithmic solution associated with a time series segment."@en ;
    rdfs:subClassOf mls:Algorithm,
        semts:MethodKnowledge ;
    owl:disjointWith semts:Hyperparameter .

semts:ModelInstance a owl:Class ;
    rdfs:label "Model Instance"@en ;
    rdfs:comment "This class describes a trained model in the traditional machine learning sense. It inherits from mls:Model and serves as a knowledge entity for subsequent predictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom semts:KnowledgeGenerationMethod ;
            owl:onProperty semts:knowledgeGenerationEntity ],
        mls:Model,
        semts:DataKnowledge ;
    owl:disjointWith semts:SegmentDataCharacteristic,
        semts:SegmentPrediction,
        semts:SegmentRelation .

semts:after a owl:ObjectProperty ;
    rdfs:label "after"@en ;
    rdfs:comment "Allen’s interval algebra relation 'after' (OWL-Time time:intervalAfter). Inverse of :before. For TimeSeriesSegment individuals, this can be inferred from their :segmentIndex: A starts after B ends."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:inverseOf semts:before ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalAfter [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalAfter .

semts:commonContextKnowledge a owl:ObjectProperty ;
    rdfs:label "common context knowledge"@en ;
    rdfs:comment "Associates a TimeSeriesSegment with CommonContextKnowledge that is contextually relevant under the segment conditions without asserting that the knowledge proposition is directly scoped to the segment."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:CommonContextKnowledge ;
    owl:propertyDisjointWith semts:multiSegmentKnowledge,
        semts:segmentKnowledge .

semts:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment "Allen’s interval algebra relation 'contains' (OWL-Time time:intervalContains). Inverse of :during. For TimeSeriesSegment individuals, inferable via :segmentIndex: A fully contains B."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:inverseOf semts:during ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalContains [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalContains .

semts:correspondingOwlTimeRelation a owl:AnnotationProperty ;
    rdfs:label "corresponding OWL-Time relation"@en ;
    rdfs:comment "Links a SemTS Allen relation to the OWL-Time interval relation between segment indexes from which it follows through its property chain. The SemTS relations are deliberately not sub-properties of the OWL-Time relations: segments are datasets, not temporal intervals. Because the OWL-Time relations are defined for proper intervals, the SemTS Allen relations apply to segments whose index is a bounded time:Interval, not a time:Instant."@en .

semts:datasetColumnIndex a owl:DatatypeProperty ;
    rdfs:label "column index"@en ;
    rdfs:comment "Specifies the column index of a time series segment within a data file or database, in case a source contains multiple time series (e.g. nested dataframes)."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] .

semts:datasetRowIndex a owl:DatatypeProperty ;
    rdfs:label "row index"@en ;
    rdfs:comment "Specifies the row index of a time series segment within a data file or database, in case a source contains multiple time series (e.g. nested dataframes)."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] .

semts:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Can be used to optionally add a description to an entity of the domain."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( semts:DataDimension semts:Knowledge semts:KnowledgeGenerationEntity semts:KnowledgeGenerationIO semts:KnowledgeQualityMeasure semts:TimeSeriesSegment semts:Value ) ] ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dcterms:description ;
    rdfs:subPropertyOf owl:topDataProperty .

semts:dimensionPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dimension position"@en ;
    rdfs:comment "Specifies the position of the associated dimension within a dataframe or similar ordered data structures."@en ;
    rdfs:domain semts:DataDimension ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:int ;
            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:int ] ) ] ;
    rdfs:subPropertyOf owl:topDataProperty .

semts:equals a owl:ObjectProperty ;
    rdfs:label "equals"@en ;
    rdfs:comment "Allen’s interval algebra relation 'equals' (OWL-Time time:intervalEquals). For TimeSeriesSegment individuals, inferable via :segmentIndex: A and B have identical start and end."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalEquals [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalEquals .

semts:finishedBy a owl:ObjectProperty ;
    rdfs:label "finished by"@en ;
    rdfs:comment "Allen’s interval algebra relation 'finishedBy' (OWL-Time time:intervalFinishedBy). Inverse of :finishes. For TimeSeriesSegment individuals, inferable via :segmentIndex: A is finished by B, both end together and B starts before A."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:inverseOf semts:finishes ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalFinishedBy [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalFinishedBy .

semts:hasDatatype a owl:ObjectProperty ;
    rdfs:label "has datatype"@en ;
    rdfs:comment "Assigns a qudt:Datatype instance (for example from http://qudt.org/vocab/datatype/) to a DataDimension or to an instance of a Value subclass."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( semts:DataDimension semts:EmbeddedValue semts:ReferencedValue ) ] ;
    rdfs:range qudt:Datatype .

semts:hasUnit a owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    rdfs:comment "Assigns a qudt:Unit instance (for example from http://qudt.org/vocab/unit/) to a DataDimension or to an instance of a Value subclass."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( semts:DataDimension semts:EmbeddedValue semts:ReferencedValue ) ] ;
    rdfs:range qudt:Unit .

semts:inputDataReference a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "input data reference"@en ;
    rdfs:comment "Defines the relation from a Knowledge Generation Input to a Time Series Segment and thus to metadata which specifies the underlying data."@en ;
    rdfs:domain semts:KnowledgeGenerationInput ;
    rdfs:range semts:TimeSeriesSegment ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:inputKnowledge a owl:ObjectProperty ;
    rdfs:label "input knowledge"@en ;
    rdfs:comment "Similar to the Input Data Reference, this relation defines all the knowledge associated with the input of a Knowledge Generation Entity."@en ;
    rdfs:domain semts:KnowledgeGenerationInput ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:knowledgeQualityMeasure a owl:ObjectProperty ;
    rdfs:label "knowledge quality measure"@en ;
    rdfs:comment "Allows to assign a quality measure to instantiated knowledge."@en ;
    rdfs:domain semts:Knowledge ;
    rdfs:range semts:KnowledgeQualityMeasure ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:meets a owl:ObjectProperty ;
    rdfs:label "meets"@en ;
    rdfs:comment "Allen’s interval algebra relation 'meets' (OWL-Time time:intervalMeets). For TimeSeriesSegment individuals, inferable via :segmentIndex: A ends exactly when B starts, with no overlap."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:inverseOf semts:metBy ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalMeets [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalMeets .

semts:overlappedBy a owl:ObjectProperty ;
    rdfs:label "overlapped by"@en ;
    rdfs:comment "Allen’s interval algebra relation 'overlappedBy' (OWL-Time time:intervalOverlappedBy). Inverse of :overlaps. For TimeSeriesSegment individuals, inferable via :segmentIndex: A is overlapped by B."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:inverseOf semts:overlaps ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalOverlappedBy [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalOverlappedBy .

semts:startedBy a owl:ObjectProperty ;
    rdfs:label "started by"@en ;
    rdfs:comment "Allen’s interval algebra relation 'startedBy' (OWL-Time time:intervalStartedBy). Inverse of :starts. For TimeSeriesSegment individuals, inferable via :segmentIndex: A is started by B, both start together and B finishes before A."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:inverseOf semts:starts ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalStartedBy [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalStartedBy .

semts:title a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "Can be used to optionally add a title to an entity of the domain."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( semts:DataDimension semts:Knowledge semts:KnowledgeGenerationEntity semts:KnowledgeGenerationIO semts:KnowledgeQualityMeasure semts:TimeSeriesSegment semts:Value ) ] ;
    rdfs:range xsd:string ;
    rdfs:seeAlso dcterms:title ;
    rdfs:subPropertyOf owl:topDataProperty .

semts:ArtificialTimeSeriesSegment a owl:Class ;
    rdfs:label "Artificial Time Series Segment"@en ;
    rdfs:comment "A time series segment that does not, or only partially refer to concrete time series data. It represents an artificially generated time series segment that might for instance describe the result of a forecast with a time index not being in the range of the original time series data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom semts:ArtificialTimeSeriesSegment ;
            owl:onProperty semts:isPartOf ],
        semts:TimeSeriesSegment .

semts:CommonContextKnowledge a owl:Class ;
    rdfs:label "Common Context Knowledge"@en ;
    rdfs:comment "Knowledge that represents contextual information whose proposition is not intrinsically scoped to a particular TimeSeriesSegment or a particular set of segments. It may nevertheless be associated with selected segments through commonContextKnowledge. The class is not disjoint with DataKnowledge, ScenarioKnowledge, or MethodKnowledge. Whenever this type is present, segment association must still use commonContextKnowledge rather than segmentKnowledge or multiSegmentKnowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:hasValue ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass semts:TimeSeriesSegment ;
            owl:onProperty [ owl:inverseOf semts:segmentKnowledge ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass semts:TimeSeriesSegment ;
            owl:onProperty [ owl:inverseOf semts:multiSegmentKnowledge ] ],
        semts:Knowledge .

semts:Hyperparameter a owl:Class ;
    rdfs:label "Parameter Recommendation"@en ;
    rdfs:comment "A hyperparameter is considered method knowledge as this class can be used to define knowledge about an appropriate or optimal hyperparameter setting associated with the analysis of a time series segment for a concrete task."@en ;
    rdfs:subClassOf mls:Hyperparameter,
        semts:MethodKnowledge .

semts:KnowledgeComparisonMeasure a owl:Class ;
    rdfs:label "Knowledge Comparison Measure"@en ;
    rdfs:comment "Any knowledge that is generated by a comparison of compatible inputs. This might either be raw data or already defined knowledge. A simple example might be the result of a Euclidean distance."@en ;
    rdfs:subClassOf semts:KnowledgeGenerationEntity .

semts:KnowledgeConcept a owl:Class ;
    rdfs:label "Knowledge Concept"@en ;
    rdfs:comment "An SKOS concept associated with the knowledge class or any corresponding subclass"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( skos:Collection skos:Concept ) ] .

semts:KnowledgeGenerationConcept a owl:Class ;
    rdfs:label "Knowledge Generation Concept"@en ;
    rdfs:comment "An SKOS concept associated with the knowledge generation entity class or any corresponding subclass"@en ;
    rdfs:subClassOf skos:Concept .

semts:KnowledgeReasoning a owl:Class ;
    rdfs:label "Knowledge Reasoning"@en ;
    rdfs:comment """To complement any knowledge that is generated via analytical methods, this class represents knowledge generated from reasoning processes. This also includes validation processes from human experts or results from reasoning tools.
While many analysis results can be regarded unvalidated predictions, this class defines subsequent evaluations to further derive concrete facts or confirmations."""@en ;
    rdfs:subClassOf semts:KnowledgeGenerationEntity .

semts:QualityMeasureConcept a owl:Class ;
    rdfs:label "Quality Measure Concept"@en ;
    rdfs:comment "An SKOS concept associated with the quality measure class"@en ;
    rdfs:subClassOf skos:Concept .

semts:SegmentDataCharacteristic a owl:Class ;
    rdfs:label "Segment Data Characteristic"@en ;
    rdfs:comment "Defines analytical, data-specific insights including derived statistics or other structural characteristics such as representative kernel expressions. Knowledge of this class mostly equals extracted data features."@en ;
    rdfs:subClassOf semts:DataKnowledge ;
    owl:disjointWith semts:SegmentPrediction,
        semts:SegmentRelation .

semts:before a owl:ObjectProperty ;
    rdfs:label "before"@en ;
    rdfs:comment "Allen’s interval algebra relation 'before' (OWL-Time time:intervalBefore). For TimeSeriesSegment individuals, this can be inferred from their :segmentIndex temporal entities: A ends before B starts."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalBefore [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalBefore .

semts:during a owl:ObjectProperty ;
    rdfs:label "during"@en ;
    rdfs:comment "Allen’s interval algebra relation 'during' (OWL-Time time:intervalDuring). For TimeSeriesSegment individuals, inferable via :segmentIndex: A occurs strictly within B (start and end inside B)."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalDuring [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalDuring .

semts:finishes a owl:ObjectProperty ;
    rdfs:label "finishes"@en ;
    rdfs:comment "Allen’s interval algebra relation 'finishes' (OWL-Time time:intervalFinishes). For TimeSeriesSegment individuals, inferable via :segmentIndex: A and B share the same end, and A starts after B."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalFinishes [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalFinishes .

semts:groupKnowledge a owl:ObjectProperty ;
    rdfs:label "group knowledge"@en ;
    rdfs:comment "References any knowledge within a particular knowledge group."@en ;
    rdfs:domain semts:KnowledgeGroup ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:isPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Defines a hierarchic relationship between time series segments. The intuition of this property is to differentiate between complete time series, in a sense that it includes the data from start to end and subsegments which are reduced in time or dimensionality and thus can be considered a slice of this original data."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:knowledgeConcept a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "knowledge concept"@en ;
    rdfs:comment "Relates a concept for a Knowledge instance. Can be used to assign concrete instances from the SemTS taxonomy."@en ;
    rdfs:domain semts:Knowledge ;
    rdfs:range semts:KnowledgeConcept ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:knowledgeGenerationConcept a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "knowledge generation concept"@en ;
    rdfs:comment "Relates a concept for a Knowledge Generation instance."@en ;
    rdfs:domain semts:KnowledgeGenerationEntity ;
    rdfs:range semts:KnowledgeGenerationConcept .

semts:metBy a owl:ObjectProperty ;
    rdfs:label "met by"@en ;
    rdfs:comment "Allen’s interval algebra relation 'metBy' (OWL-Time time:intervalMetBy). Inverse of :meets. For TimeSeriesSegment individuals, inferable via :segmentIndex: A starts exactly when B ends."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalMetBy [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalMetBy .

semts:outputKnowledge a owl:ObjectProperty ;
    rdfs:label "output knowledge"@en ;
    rdfs:comment "Opposed to Input Knowledge, this property defines the knowledge included in the output of a Knowledge generation Entity."@en ;
    rdfs:domain semts:KnowledgeGenerationOutput ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:overlaps a owl:ObjectProperty ;
    rdfs:label "overlaps"@en ;
    rdfs:comment "Allen’s interval algebra relation 'overlaps' (OWL-Time time:intervalOverlaps). For TimeSeriesSegment individuals, inferable via :segmentIndex: A starts before B and ends during B (partial overlap)."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalOverlaps [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalOverlaps .

semts:qualityMeasureConcept a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "quality measure concept"@en ;
    rdfs:comment "Defines the concept of a particular Knowledge Quality Measure."@en ;
    rdfs:domain semts:KnowledgeQualityMeasure ;
    rdfs:range semts:QualityMeasureConcept ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:segmentDimension a owl:ObjectProperty ;
    rdfs:label "segment dimension"@en ;
    rdfs:comment "Defines the dimensions associated with a Time Series Segment. Multiple dimensions indicate that the segment corresponds to a multivariate time series."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:DataDimension ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:starts a owl:ObjectProperty ;
    rdfs:label "starts"@en ;
    rdfs:comment "Allen’s interval algebra relation 'starts' (OWL-Time time:intervalStarts). For TimeSeriesSegment individuals, inferable via :segmentIndex: A and B share the same start, and A finishes before B."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:TimeSeriesSegment ;
    owl:propertyChainAxiom ( semts:segmentIndex time:intervalStarts [ owl:inverseOf semts:segmentIndex ] ) ;
    semts:correspondingOwlTimeRelation time:intervalStarts .

semts:used a owl:ObjectProperty ;
    rdfs:label "used"@en ;
    rdfs:comment "Relates a KnowledgeGenerationEntity to an input it used. Specialisation of prov:used."@en ;
    rdfs:domain semts:KnowledgeGenerationEntity ;
    rdfs:range semts:KnowledgeGenerationInput ;
    rdfs:subPropertyOf prov:used .

semts:valueString a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "value string"@en ;
    rdfs:comment "The string representation of a concrete EmbeddedValue. Its datatype is specified through hasDatatype."@en ;
    rdfs:domain semts:EmbeddedValue ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

semts:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "Relates a KnowledgeGenerationOutput to the input it was derived from. Specialisation of prov:wasDerivedFrom."@en ;
    rdfs:domain semts:KnowledgeGenerationOutput ;
    rdfs:range semts:KnowledgeGenerationInput ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

qudt:Datatype a owl:Class ;
    rdfs:label "QUDT Datatype"@en ;
    rdfs:comment "A datatype in QUDT used to specify the data type of values (e.g., quantity values). Instances are defined in the QUDT datatype vocabulary, http://qudt.org/vocab/datatype/."@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
    rdfs:seeAlso <http://qudt.org/doc/DOC_SCHEMA-QUDT.html#Classes> .

qudt:Unit a owl:Class ;
    rdfs:label "QUDT Unit"@en ;
    rdfs:comment "A unit of measure (e.g., meter, second). Instances are defined in the QUDT unit vocabulary, http://qudt.org/vocab/unit/."@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
    rdfs:seeAlso <http://qudt.org/doc/DOC_SCHEMA-QUDT.html#Classes> .

mls:Algorithm a owl:Class ;
    rdfs:label "MLS Algorithm"@en ;
    rdfs:comment "An algorithm (method or procedure) described in the Machine Learning Schema."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/mls> ;
    rdfs:seeAlso <https://www.w3.org/TR/mls/#Algorithm> .

mls:EvaluationMeasure a owl:Class ;
    rdfs:label "MLS Evaluation Measure"@en ;
    rdfs:comment "A metric used to evaluate the performance or quality of an ML process or result."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/mls> ;
    rdfs:seeAlso <https://www.w3.org/TR/mls/#EvaluationMeasure> .

mls:Hyperparameter a owl:Class ;
    rdfs:label "MLS Hyperparameter"@en ;
    rdfs:comment "A configuration parameter not learned from data that influences the behavior of an algorithm."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/mls> ;
    rdfs:seeAlso <https://www.w3.org/TR/mls/#Hyperparameter> .

mls:Implementation a owl:Class ;
    rdfs:label "MLS Implementation"@en ;
    rdfs:comment "A specific implementation of an algorithm or method described in the Machine Learning Schema."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/mls> ;
    rdfs:seeAlso <https://www.w3.org/TR/mls/#Implementation> .

mls:Model a owl:Class ;
    rdfs:label "MLS Model"@en ;
    rdfs:comment "A learned or specified model representing the result of training or configuration."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/mls> ;
    rdfs:seeAlso <https://www.w3.org/TR/mls/#Model> .

semts:KnowledgeGenerationMethod a owl:Class ;
    rdfs:label "Knowledge Generation Method"@en ;
    rdfs:comment "Defines a knowledge generation entity, which corresponds to method-based solution. Compared to other knowledge generation entities this class is a subclass of mls:Implementation and thus can be linked to algorithmic details."@en ;
    rdfs:subClassOf mls:Implementation,
        semts:KnowledgeGenerationEntity .

semts:KnowledgeGroup a owl:Class ;
    rdfs:label "Knowledge Group"@en ;
    rdfs:comment "A grouping of knowledge which itself is again considered knowledge. Can be used to structure knowledge and create hierarchies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:groupKnowledge ],
        semts:Knowledge ;
    owl:disjointWith semts:MethodKnowledge,
        semts:ScenarioKnowledge .

semts:SegmentPrediction a owl:Class ;
    rdfs:label "Segment Prediction"@en ;
    rdfs:comment "Defines knowledge derived from data-driven analyses. This for instance includes anomalies and predictions."@en ;
    rdfs:subClassOf semts:DataKnowledge ;
    owl:disjointWith semts:SegmentRelation .

semts:UndirectedKnowledgeRelation a owl:Class ;
    rdfs:label "Undirected Knowledge Relation"@en ;
    rdfs:comment "A KnowledgeRelation with at least two unordered Knowledge participants. It does not use the directed source or target roles. Its semantic meaning is supplied through knowledgeConcept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:knowledgeRelationTarget ],
        [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:knowledgeRelationSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass semts:Knowledge ;
            owl:onProperty semts:knowledgeRelationParticipant ],
        semts:KnowledgeRelation .

semts:generated a owl:ObjectProperty ;
    rdfs:label "generated"@en ;
    rdfs:comment "Relates a KnowledgeGenerationEntity to an output it generated. Specialisation of prov:generated."@en ;
    rdfs:domain semts:KnowledgeGenerationEntity ;
    rdfs:range semts:KnowledgeGenerationOutput ;
    rdfs:subPropertyOf prov:generated .

semts:knowledgeGenerationEntity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "knowledge generation entity"@en ;
    rdfs:comment "Relates the Knowledge Generation Entity, which produced this Knowledge instance."@en ;
    rdfs:domain semts:Knowledge ;
    rdfs:range semts:KnowledgeGenerationEntity ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:knowledgeRelationSource a owl:ObjectProperty ;
    rdfs:label "knowledge relation source"@en ;
    rdfs:comment "Relates a DirectedKnowledgeRelation to a Knowledge instance in the source-side role defined by the relation concept."@en ;
    rdfs:domain semts:DirectedKnowledgeRelation ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf semts:knowledgeRelationParticipant .

semts:knowledgeRelationTarget a owl:ObjectProperty ;
    rdfs:label "knowledge relation target"@en ;
    rdfs:comment "Relates a DirectedKnowledgeRelation to a Knowledge instance in the target-side role defined by the relation concept."@en ;
    rdfs:domain semts:DirectedKnowledgeRelation ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf semts:knowledgeRelationParticipant .

semts:segmentKnowledge a owl:ObjectProperty ;
    rdfs:label "segment knowledge"@en ;
    rdfs:comment "Relates any Knowledge available for a particular Time Series Segment."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://w3id.org/semts/agent/alexander-grass> a owl:NamedIndividual,
        foaf:Person ;
    foaf:mbox <mailto:grass.alexan@gmail.com> ;
    foaf:name "Alexander Graß" .

semts:DirectedKnowledgeRelation a owl:Class ;
    rdfs:label "Directed Knowledge Relation"@en ;
    rdfs:comment "A KnowledgeRelation with one or more source Knowledge instances and one or more target Knowledge instances. Its semantic meaning is supplied through knowledgeConcept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass semts:Knowledge ;
            owl:onProperty semts:knowledgeRelationSource ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass semts:Knowledge ;
            owl:onProperty semts:knowledgeRelationTarget ],
        semts:KnowledgeRelation ;
    owl:disjointWith semts:UndirectedKnowledgeRelation .

semts:EmbeddedValue a owl:Class ;
    rdfs:label "Embedded Value"@en ;
    rdfs:comment """Refers to a value that is directly stored in the knowledge graph. Compared to referenced values, these values are rather single, non-complex values having a primitive type.
One example could be the mean value of a univariate time series."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:valueString ],
        semts:Value ;
    owl:disjointWith semts:ReferencedValue .

semts:KnowledgeRelation a owl:Class ;
    rdfs:label "Knowledge Relation"@en ;
    rdfs:comment "Abstract Knowledge superclass for a semantic relationship among Knowledge instances. It is not intended for direct instantiation: every relation individual is directed or undirected. Relation meanings are expressed by a KnowledgeConcept from any suitable vocabulary. The core ontology imposes no fixed relation concept scheme."@en ;
    rdfs:subClassOf semts:Knowledge ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( semts:DirectedKnowledgeRelation semts:UndirectedKnowledgeRelation ) ] .

semts:ReferencedValue a owl:Class ;
    rdfs:label "Referenced Value"@en ;
    rdfs:comment "Refers to a value that is of arbitrary complexity and not directly stored in the knowledge graph. This class inherits from dcat:Resource and can be retrieved by the associated metadata. Dataset-valued resources may additionally be typed as dcat:Dataset. Examples include documents, models, images, fragments, or generated shapelet collections."@en ;
    rdfs:subClassOf dcat:Resource,
        semts:Value .

semts:ScenarioKnowledge a owl:Class ;
    rdfs:label "Scenario Knowledge"@en ;
    rdfs:comment "Defines any knowledge that is associated with a particular scenario or domain. Scenario knowledge corresponds to validated expert knowledge or scenario-specific facts. It includes simple notes, predefined labels or mathematical expressions describing the underlying time series data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:hasValue ],
        semts:Knowledge .

semts:SegmentRelation a owl:Class ;
    rdfs:label "Segment Relation"@en ;
    rdfs:comment "Defines knowledge that relates multiple segments, for example through cross-correlation or a distance measure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf semts:multiSegmentKnowledge ] ],
        semts:DataKnowledge .

semts:Value a owl:Class ;
    rdfs:label "Value"@en ;
    rdfs:comment "This abstract class serves as parental class of EmbeddedValue and ReferencedValue."@en .

semts:knowledgeRelationParticipant a owl:ObjectProperty ;
    rdfs:label "knowledge relation participant"@en ;
    rdfs:comment "Relates a KnowledgeRelation to a participating Knowledge instance. It is used directly for undirected relations and is the superproperty of the directed source and target roles."@en ;
    rdfs:domain semts:KnowledgeRelation ;
    rdfs:range semts:Knowledge .

skos:Collection a owl:Class ;
    rdfs:label "SKOS Collection"@en ;
    rdfs:comment "A meaningful collection of concepts in SKOS."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:seeAlso <https://www.w3.org/TR/skos-reference/#collections> .

skos:Concept a owl:Class ;
    rdfs:label "SKOS Concept"@en ;
    rdfs:comment "An idea or notion used to support knowledge organization, the fundamental unit of SKOS."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:seeAlso <https://www.w3.org/TR/skos-reference/#concepts> .

semts:DataKnowledge a owl:Class ;
    rdfs:label "Data Knowledge"@en ;
    rdfs:comment "Defines knowledge derived from data. This includes statistics, signal characteristics, and knowledge generated through data-analysis methods, such as predictions, anomalies, or cluster memberships."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:hasValue ],
        semts:Knowledge ;
    owl:disjointWith semts:KnowledgeGroup,
        semts:MethodKnowledge,
        semts:ScenarioKnowledge .

semts:KnowledgeGenerationIO a owl:Class ;
    rdfs:label "Knowledge Generation IO"@en ;
    rdfs:comment "Defines any input and output of a knowledge generation entity. It inherits from prov:Entity to define instances that are used by or generated by a prov:Activity, which in turn is the parental class of a knowledge generation entity."@en ;
    rdfs:subClassOf prov:Entity .

semts:KnowledgeGenerationInput a owl:Class ;
    rdfs:label "Knowledge Generation Input"@en ;
    rdfs:comment "Defines the input of a knowledge generation entity. While outputs can only contain produced knowledge, inputs might either reference knowledge or raw data."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty semts:inputDataReference ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty semts:inputKnowledge ] ) ],
        semts:KnowledgeGenerationIO ;
    owl:disjointWith semts:KnowledgeGenerationOutput .

semts:KnowledgeGenerationOutput a owl:Class ;
    rdfs:label "Knowledge Generation Output"@en ;
    rdfs:comment "Defines the output of a knowledge generation entity. Compared to inputs, outputs only allow for a reference to generated knowledge and not to raw data. This, on purpose, excludes data transformations from the overall ontology concept by only focusing on a propagation of knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:wasDerivedFrom ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass semts:KnowledgeGenerationEntity ;
            owl:onProperty [ owl:inverseOf semts:generated ] ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:outputKnowledge ],
        semts:KnowledgeGenerationIO .

semts:MethodKnowledge a owl:Class ;
    rdfs:label "Method Knowledge"@en ;
    rdfs:comment "Any knowledge that defines an appropriate setting, regarding a particular method that is beneficial or even optimal when analyzing a segment given a particular task."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:hasValue ],
        semts:Knowledge ;
    owl:disjointWith semts:ScenarioKnowledge .

semts:KnowledgeQualityMeasure a owl:Class ;
    rdfs:label "Knowledge Quality Measure"@en ;
    rdfs:comment "Defines the goodness or confidence of time series knowledge associated with one or multiple segments. For knowledge produced by a knowledge generation method the quality measure is often equal to the evaluation metric of the generation method, which is why this class inherits from mls:EvaluationMeasure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:hasValue ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:qualityMeasureConcept ],
        mls:EvaluationMeasure .

semts:hasValue a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has value"@en ;
    rdfs:comment "Relationship to the Value class and thus to allow for a reference to stored data."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( semts:Knowledge semts:KnowledgeQualityMeasure ) ] ;
    rdfs:range semts:Value ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:multiSegmentKnowledge a owl:ObjectProperty ;
    rdfs:label "multi segment knowledge"@en ;
    rdfs:comment "Relates each member of a jointly considered set of at least two time-series segments to the same Knowledge individual, where the proposition is meaningful or valid only with respect to that segment set collectively and cannot be represented as independent knowledge assertions for its individual members. Generation inputs are provenance and do not by themselves determine this collective scope."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range semts:Knowledge ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:DataDimension a owl:Class ;
    rdfs:label "Data Dimension"@en ;
    rdfs:comment "Defines a data dimension (or also referred to as feature or attribute) in a time series segment."@en .

semts:KnowledgeGenerationEntity a owl:Class ;
    rdfs:label "Knowledge Generation Entity"@en ;
    rdfs:comment "Represents the highest entity to define the process of knowledge generation. A more specific description can be provided by subclasses or assigned concepts. This class inherits from prov:Activity and thus allows for provenance during knowledge propagation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:generated ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:used ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:knowledgeGenerationConcept ],
        prov:Activity .

semts:Knowledge a owl:Class ;
    rdfs:label "Knowledge"@en ;
    rdfs:comment "Represents the highest level of any knowledge associated with time series data. Knowledge can be made more specific via subclasses or associated concepts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:knowledgeGenerationEntity ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:knowledgeConcept ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:minCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onProperty [ owl:inverseOf semts:multiSegmentKnowledge ] ] [ a owl:Restriction ;
                        owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty [ owl:inverseOf semts:multiSegmentKnowledge ] ] ) ] .

semts:segmentIndex a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "segment index"@en ;
    rdfs:comment "Defines the index associated with a Time Series Segment. Inherits from the time:TemporalEntity."@en ;
    rdfs:domain semts:TimeSeriesSegment ;
    rdfs:range time:TemporalEntity ;
    rdfs:subPropertyOf owl:topObjectProperty .

semts:TimeSeriesSegment a owl:Class ;
    rdfs:label "Time Series Segment"@en ;
    rdfs:comment "Represents a segment, also referred to as a slice, of a univariate or multivariate time series. A segment may cover the complete time series, a subinterval restricted to selected dimensions, or a single data point. The class inherits from dcat:Dataset and identifies its temporal index, represented data dimensions, distributions, and associated knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dcat:distribution ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty semts:segmentIndex ],
        dcat:Dataset .

[] a owl:AllDisjointClasses ;
    owl:members ( semts:KnowledgeComparisonMeasure semts:KnowledgeGenerationMethod semts:KnowledgeReasoning ) .

