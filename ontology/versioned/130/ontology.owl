  <rdf:Description rdf:about="http://qudt.org/schema/qudt/Datatype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A datatype in QUDT used to specify the data type of values (e.g., quantity values). Instances are defined in the QUDT datatype vocabulary, http://qudt.org/vocab/datatype/.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
    <rdfs:label xml:lang="en">QUDT Datatype</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://qudt.org/doc/DOC_SCHEMA-QUDT.html#Classes"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/schema/qudt/Unit">
