    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/mls"/>
    <rdfs:label xml:lang="en">MLS Hyperparameter</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/mls/#Hyperparameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/mls#Implementation">
