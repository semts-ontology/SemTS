    <rdfs:comment xml:lang="en">A unit of measure (e.g., meter, second). Instances are defined in the QUDT unit vocabulary, http://qudt.org/vocab/unit/.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
    <rdfs:label xml:lang="en">QUDT Unit</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://qudt.org/doc/DOC_SCHEMA-QUDT.html#Classes"/>
  </rdf:Description>
