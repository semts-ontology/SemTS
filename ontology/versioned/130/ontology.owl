  <rdf:Description rdf:about="http://www.w3.org/ns/mls#EvaluationMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A metric used to evaluate the performance or quality of an ML process or result.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/mls"/>
    <rdfs:label xml:lang="en">MLS Evaluation Measure</rdfs:label>
