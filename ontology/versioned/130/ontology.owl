    <rdfs:comment xml:lang="en">A specific implementation of an algorithm or method described in the Machine Learning Schema.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/mls"/>
    <rdfs:label xml:lang="en">MLS Implementation</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/mls/#Implementation"/>
  </rdf:Description>
