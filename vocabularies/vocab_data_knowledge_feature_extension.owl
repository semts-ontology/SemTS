  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ARCoefficient">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.ar_coefficient"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#TemporalDependenceProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Coefficients from unconditional MLE fit of an AR(k) process.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">AR coefficient</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#AbsEnergy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.abs_energy"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#MagnitudeProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Sum over squared values of the time series (absolute energy).</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
