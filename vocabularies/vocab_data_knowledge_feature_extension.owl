    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
