  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#AugmentedDickeyFuller">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
