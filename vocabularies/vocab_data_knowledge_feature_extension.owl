    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.sample_entropy"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ComplexityProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Sample entropy of the time series.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Sample entropy</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Skewness">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DistributionShapeProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">A measure of the asymmetry of the probability distribution.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Skewness</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SpectralPeak">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#FrequencyDomainProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Significant peaks in the frequency spectrum indicating dominant periodic components.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Spectral Peak</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#StandardDeviation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DispersionProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">A measure of the amount of variation in the segment.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Standard deviation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SumOfReoccurringDataPoints">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.sum_of_reoccurring_data_points"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataInformationProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Sum of all data points that occur more than once.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Sum of reoccurring datapoints</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SumOfReoccurringValues">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.sum_of_reoccurring_values"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataInformationProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Sum of all values that occur more than once.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Sum of reoccurring values</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SumValues">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.sum_values"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataInformationProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Sum over all time series values.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Sum of values</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SymmetryLooking">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.symmetry_looking"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DistributionShapeProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Boolean indicating whether the distribution looks symmetric.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Symmetry looking</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#TimeReversalAsymmetryStatistic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.time_reversal_asymmetry_statistic"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#StructuralProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Statistic measuring asymmetry under time reversal at a given lag.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Time-reversal asymmetry statistic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ValueCount">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.value_count"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataInformationProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Count of occurrences of a specified value.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Value count</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ValueMask">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataInformationProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">A mask indicating positions whose values are missing, invalid, excluded, or imputed.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Value Mask</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ValueRange">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DispersionProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">The difference between the maximum and minimum values in the segment.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Value range</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Variance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DispersionProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Variance of the attribute values.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Variance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#VarianceLargerThanStandardDeviation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.variance_larger_than_standard_deviation"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DispersionProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Boolean indicating whether variance(x) &gt; std(x).</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Variance larger than std</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#VariationCoefficient">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.variation_coefficient"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DispersionProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Relative variation: standard error divided by mean.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Variation coefficient</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension">
    <dct:conformsTo rdf:resource="https://www.w3.org/TR/skos-reference/"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-06</dct:created>
    <dct:description xml:lang="en">Default-imported extension containing concrete time-series feature meanings, including general summary features and tsfresh-aligned feature calculators. Stable semantic families remain in the Data Knowledge core. The catalogue is an example of a feature extension, aligned with one feature library. It is neither complete nor normative, and further feature catalogues can extend the core in the same way.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-18</dct:modified>
    <dct:references rdf:resource="https://tsfresh.readthedocs.io/en/latest/"/>
    <dct:references rdf:resource="https://w3id.org/semts/ontology#"/>
    <dct:title xml:lang="en">SemTS Data Feature Catalogue Extension</dct:title>
    <vann:preferredNamespacePrefix>semts-dfx</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
    <skos:editorialNote xml:lang="en">Namespace policy: features published in version 1.2.0 of the Data Knowledge vocabulary keep their semts-dv IRIs so that existing data stays valid. Features added later use the semts-dfx namespace of this extension.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:scopeNote xml:lang="en">The extension is structurally separate but included by default through owl:imports from the Data Knowledge core. Feature concepts are not duplicated in the core file.</skos:scopeNote>
    <adms:status rdf:resource="http://purl.org/adms/status/Completed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Organizing concept for concrete time-series characteristics and feature results maintained outside the stable Data Knowledge core.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Detailed Time-Series Feature</skos:prefLabel>
    <skos:scopeNote xml:lang="en">This extension is imported by the Data Knowledge core. Concrete features occur only in this file, while their stable semantic families remain in the core.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#LinearTrend">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <rdfs:seeAlso rdf:resource="https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.linear_trend"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#TrendProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">A statistic of the linear least-squares regression of the values against their position in the series: p-value, correlation coefficient r, intercept, slope, or standard error.</skos:definition>
    <skos:editorialNote xml:lang="en">Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Linear trend statistic</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use semts-dv:LinearSlope and semts-dv:LinearIntercept for those two statistics. For the p-value, r value and standard error, use this concept and name the statistic in semts:title.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#Periodicity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#PeriodicityProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">The presence or strength of repeating behavior at one or more periods.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Periodicity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#Seasonality">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#PeriodicityProperty"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#DetailedTimeSeriesFeature"/>
    <skos:definition xml:lang="en">Systematic periodic variation associated with a recurring calendar or operational cycle.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge/feature-extension"/>
    <skos:prefLabel xml:lang="en">Seasonality</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core.</skos:scopeNote>
  </rdf:Description>
</rdf:RDF>
