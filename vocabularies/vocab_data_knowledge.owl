  <rdf:Description rdf:about="https://w3id.org/semts/ontology#KnowledgeConcept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge">
    <dct:conformsTo rdf:resource="https://www.w3.org/TR/skos-reference/"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-25</dct:created>
    <dct:description xml:lang="en">A stable, domain-neutral SKOS core for knowledge derived from time-series data. Concrete feature concepts are structurally separated into a default-imported feature extension.</dct:description>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-18</dct:modified>
    <dct:references rdf:resource="https://github.com/semts-ontology/SemTS"/>
    <dct:references rdf:resource="https://w3id.org/semts/ontology#"/>
    <dct:title xml:lang="en">SemTS Data Knowledge Vocabulary</dct:title>
    <vann:preferredNamespacePrefix>semts-dv</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/semts/vocabulary/data-knowledge#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <owl:imports rdf:resource="https://semts-ontology.github.io/SemTS/vocabularies/vocab_data_knowledge_feature_extension.owl"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
    <skos:editorialNote xml:lang="en">Concept IRIs published in version 1.2.0 of this vocabulary keep their semts-dv IRIs, including the concrete features that moved to the feature extension. Concepts added after 1.2.0 to the extension use the semts-dfx namespace.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataKnowledge"/>
    <skos:scopeNote xml:lang="en">The core contains stable result categories, prediction meanings, relation meanings, model artifacts, representation results, and decomposition components. It does not duplicate concrete features declared in the imported feature extension.</skos:scopeNote>
    <adms:status rdf:resource="http://purl.org/adms/status/Completed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentPrediction"/>
    <skos:definition xml:lang="en">Knowledge that enriches existing records by attaching labels or classes about outcomes such as events and anomalies.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Annotation Level Prediction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Anomaly">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Knowledge asserting that a data point, interval, segment, or group deviates from an expected reference or pattern.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Anomaly</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#AssociationRule">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">A conditional association between patterns, events, states, or knowledge propositions.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Association Rule</skos:prefLabel>
    <skos:scopeNote xml:lang="en">When represented as a directed relation, source is the antecedent and target is the consequent.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#CausalGraph">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#RelationStructure"/>
    <skos:definition xml:lang="en">Network representation of causal relationships between time series variables.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Causal Graph</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#CausalInfluence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Causality"/>
    <skos:definition xml:lang="en">A directional influence whose intervention or change can affect a target.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Causal Influence</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source causally influences target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Causality">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:altLabel xml:lang="en">Causality</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">A directed cause-effect relation inferred or estimated between segments, variables, events, or knowledge propositions. It is stronger than mere correlation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Causal Relation</skos:prefLabel>
    <skos:relatedMatch rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Causes"/>
    <skos:scopeNote xml:lang="en">Use with semts:DirectedKnowledgeRelation when the source-to-target causal orientation is represented explicitly.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#CauseEffectDependency">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Causality"/>
    <skos:definition xml:lang="en">A causal dependency in which a source contributes to or determines an effect at a target.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Cause-Effect Dependency</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source is represented as a cause of, or causal contributor to, target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ChangeProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic describing increments, differences, variation, or change intensity over time.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Change Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Changepoint">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Detection of shifts or changes in the underlying dynamics of data.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Changepoint</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ClassMembership">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#InferredAnnotation"/>
    <skos:definition xml:lang="en">A class or category membership assigned to a segment or knowledge item.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Class Membership</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Classification">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:altLabel xml:lang="en">Classification</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Knowledge assigning one or more class labels to a segment, dimension, or group of segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Classification Result</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#InferredClassID"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Cluster">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroup"/>
    <skos:definition xml:lang="en">A cluster represents one group from a clustering, characterized by shared properties.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Cluster</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroupRepresentative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ClusterMembership">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#InferredAnnotation"/>
    <skos:definition xml:lang="en">Membership of a segment or knowledge item in a cluster.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Cluster Membership</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Clustering">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:altLabel xml:lang="en">Clustering</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">Knowledge describing a grouping of segments or observations obtained by a clustering method.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Clustering Result</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Cluster"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Coherence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Correlation"/>
    <skos:definition xml:lang="en">Frequency-specific correlation measure between time series indicating synchronized behavior.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Coherence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ComplexityProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic describing regularity, entropy, compressibility, or dynamical complexity.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Complexity Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ConceptDrift">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Change in the underlying data-generating process affecting model performance over time.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Concept Drift</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ConditionRelation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">Relation expressing a necessary or sufficient condition without implying physical causation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Condition Relation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ConfidenceInterval">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ProbabilisticForecast"/>
    <skos:definition xml:lang="en">Statistical interval around point forecasts indicating parameter uncertainty.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Confidence Interval</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Correlation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">A statistical dependence relation between values, dimensions, segments, or knowledge items.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Correlation</skos:prefLabel>
    <skos:relatedMatch rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Correlation"/>
    <skos:scopeNote xml:lang="en">Use as the concept of a semts:SegmentRelation that is attached to two or more segments through semts:multiSegmentKnowledge, or of a semts:UndirectedKnowledgeRelation when the correlation holds between knowledge items, unless a directional statistical relation is explicitly intended. A correlation that is asserted by an expert rather than derived from the data is scenario knowledge (semts-sv:Correlation).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#CounterfactualPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataLevelPrediction"/>
    <skos:definition xml:lang="en">Predicted outcomes under hypothetical scenarios that did not actually occur.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Counterfactual Prediction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#CrossSpectralDensity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">Frequency domain representation of relationships between multiple time series.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Cross-Spectral Density</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#CyclicalComponent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DecompositionComponent"/>
    <skos:definition xml:lang="en">Longer-term cyclical patterns distinct from regular seasonality.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Cyclical Component</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DTWDistance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Distance"/>
    <skos:definition xml:lang="en">Dynamic Time Warping distance between sequences.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">DTW Distance</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DataInformationProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">General informational attributes of data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Data Information Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DataKnowledge">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:definition xml:lang="en">A comprehensive category encompassing various forms of knowledge derived from data analysis.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Data Knowledge</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DataLevelPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentPrediction"/>
    <skos:definition xml:lang="en">Knowledge involving the generation of data inferred from existing data.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Data Level Prediction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DecompositionComponent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Component obtained by decomposing a time series into interpretable constituent parts.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Decomposition Component</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DetectedEvent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">An event occurrence inferred from time-series data.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Detected Event</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DirectCausalEffect">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Causality"/>
    <skos:definition xml:lang="en">A causal effect not mediated by another represented cause-effect step.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Direct Causal Effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source has a direct causal effect on target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DispersionProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Measures of the spread or variability within data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Dispersion Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Distance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">A quantified dissimilarity between segments, values, representations, or knowledge items.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Distance</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use as the concept of a semts:SegmentRelation that is attached to two or more segments through semts:multiSegmentKnowledge, or of a semts:UndirectedKnowledgeRelation when the distance measure is symmetric. Asymmetric distances require a semts:DirectedKnowledgeRelation with an explicit source-to-target interpretation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#DistributionShapeProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic describing the shape of the value distribution.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Distribution Shape Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Embedding">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#RepresentationCharacteristic"/>
    <skos:definition xml:lang="en">A vector or structured representation of a segment or knowledge item in a representation space.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Embedding</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#EventIntensityForecast">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataLevelPrediction"/>
    <skos:definition xml:lang="en">Forecasted event intensity over time.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Event Intensity Forecast</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ExtremumProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic describing minimum, maximum, or extreme values and their positions.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Extremum Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#FeatureImportance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#InferredAnnotation"/>
    <skos:definition xml:lang="en">Attribution of a model’s prediction to input features or time steps.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Feature Importance</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#FeatureVector">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#RepresentationCharacteristic"/>
    <skos:definition xml:lang="en">An ordered vector of extracted characteristics associated with a segment or group.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Feature Vector</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Forecast">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataLevelPrediction"/>
    <skos:definition xml:lang="en">Predicted future values or trajectories associated with a time-series segment or continuation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Forecast</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#FrequencyDomainProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic derived from a frequency-domain or spectral representation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Frequency-Domain Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#HiddenStateSequence">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#InferredAnnotation"/>
    <skos:definition xml:lang="en">Inferred latent states from Hidden Markov Models or similar probabilistic approaches.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Hidden State Sequence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Imputation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataLevelPrediction"/>
    <skos:definition xml:lang="en">Estimated values supplied for missing or invalid observations in a time series.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Imputation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#IndirectCausalEffect">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Causality"/>
    <skos:definition xml:lang="en">A causal effect mediated by one or more intermediate entities or relations.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Indirect Causal Effect</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source has an indirect causal effect on target through one or more mediators.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#InferredAnnotation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Annotations derived from analysis that highlight inferred knowledge or insights.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Inferred Annotation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#InferredClassID">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#InferredAnnotation"/>
    <skos:definition xml:lang="en">A classification identifier derived from analysis and inference.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Inferred Class ID</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#InterventionEffect">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Causality"/>
    <skos:definition xml:lang="en">Quantified impact of external interventions on time series behavior.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Intervention Effect</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#LocationProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Properties that define the position or location within data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Location Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#MagnitudeProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic describing the overall magnitude or energy of values.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Magnitude Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Medoid">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroupRepresentative"/>
    <skos:definition xml:lang="en">An observed group member selected as the representative with minimal aggregate distance to other members.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Medoid</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ModelInstance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataKnowledge"/>
    <skos:definition xml:lang="en">A model generated via machine learning.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Model Instance</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ModelUncertainty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ProbabilisticForecast"/>
    <skos:definition xml:lang="en">Epistemic uncertainty arising from incomplete knowledge of model parameters.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Model Uncertainty</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Motif">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:altLabel xml:lang="en">Motif Collection</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroup"/>
    <skos:definition xml:lang="en">A collection of motifs instances within time series data, representing a frequently occurring pattern that provides insights into underlying processes.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Motif Group</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#MotifElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#MotifElement">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#PatternElement"/>
    <skos:definition xml:lang="en">A segment identified as an occurrence of a motif, modeled as a specialized pattern element.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Motif Element</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#NecessaryConditionRelation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ConditionRelation"/>
    <skos:definition xml:lang="en">A causal or logical relation in which the target cannot occur without the source condition.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Necessary Condition Relation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source is a necessary condition for target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#OutOfDistribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Detection of inputs outside the training distribution.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Out-of-Distribution (OOD) Detection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Pattern">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:altLabel xml:lang="en">Pattern</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroup"/>
    <skos:definition xml:lang="en">Group of repeating data segments with the same or similar behavior.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Pattern Group</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#PatternElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#PatternElement">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">A segment identified as an occurrence or member of a repeated or otherwise characteristic pattern.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Pattern Element</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#PeriodicityProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A characteristic describing repeated, seasonal, cyclic, or periodic behavior.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Periodicity Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#PredictedEvent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Prediction of an event or action.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Predicted Event</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#PredictionInterval">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ProbabilisticForecast"/>
    <skos:definition xml:lang="en">An interval quantifying forecast uncertainty at a given coverage level (e.g., 90%).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Prediction Interval</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ProbabilisticForecast">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataLevelPrediction"/>
    <skos:definition xml:lang="en">A forecast represented as a probability distribution over future values, including quantiles or prediction intervals.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Probabilistic Forecast</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Prototype">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroupRepresentative"/>
    <skos:definition xml:lang="en">A representative constructed to summarize a group of segments or knowledge items.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Prototype</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#QuantileForecast">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ProbabilisticForecast"/>
    <skos:definition xml:lang="en">Forecast expressed by one or more quantiles (e.g., 0.1, 0.5, 0.9).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Quantile Forecast</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#RegimeChange">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#Changepoint"/>
    <skos:definition xml:lang="en">Detection of transitions between different operational regimes in time series.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Regime Change</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#RegimeDetection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">Identification of different operational states or regimes within time series data.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Regime Detection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#RelationStructure">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">Structured representation of multiple relations among segments, variables, or knowledge entities.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Relation Structure</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#RepresentationCharacteristic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">A learned or constructed representation of a segment, dimension, or group.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Representation Characteristic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#ResidualComponent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DecompositionComponent"/>
    <skos:definition xml:lang="en">Remaining variation after trend and seasonal components are removed from decomposition.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Residual Component</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SeasonalComponent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DecompositionComponent"/>
    <skos:definition xml:lang="en">Extracted seasonal patterns from time series decomposition.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Seasonal Component</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataKnowledge"/>
    <skos:definition xml:lang="en">Attributes and features that define specific data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Segment Data Characteristic</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroup">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">A collection of related segments within time series data.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Segment Group</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroupRepresentative">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">An entity that acts as a typical example or reference for a group of segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Segment Group Representative</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SegmentPrediction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataKnowledge"/>
    <skos:definition xml:lang="en">Knowledge related to predicting outcomes or future trends within data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Segment Prediction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DataKnowledge"/>
    <skos:definition xml:lang="en">Relationships and connections between different data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Segment Relation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Segmentation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:altLabel xml:lang="en">Segmentation</skos:altLabel>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">Knowledge describing a partition or boundary structure over a time series.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Segmentation Result</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroupRepresentative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Shapelet">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentGroupRepresentative"/>
    <skos:definition xml:lang="en">A characteristic subseries or pattern within a time series that is useful for classification.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Shapelet</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#Similarity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentRelation"/>
    <skos:definition xml:lang="en">A quantified or qualified resemblance relation between segments, values, representations, or knowledge items.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Similarity</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use as the concept of a semts:SegmentRelation that is attached to two or more segments through semts:multiSegmentKnowledge, or of a semts:UndirectedKnowledgeRelation when the similarity holds between knowledge items. Per-segment similarity features (for example query similarity counts) are segment data characteristics, not relations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#StateEstimate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#AnnotationLevelPrediction"/>
    <skos:definition xml:lang="en">An inferred latent or observable state associated with a segment.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">State Estimate</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#StructuralProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Attributes related to the composition or arrangement of data segments.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Structural Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#SufficientConditionRelation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ConditionRelation"/>
    <skos:definition xml:lang="en">A causal or logical relation in which the source condition is sufficient for the target under the stated context.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Sufficient Condition Relation</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source is a sufficient condition for target under the represented context.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#TemporalDependenceProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Characteristic describing dependence between observations of the same time series across temporal offsets.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Temporal Dependence Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#TemporalPointProcess">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#ModelInstance"/>
    <skos:definition xml:lang="en">A stochastic process modeling discrete events in time via an intensity function.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Temporal Point Process</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#TimeFrequencyProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Characteristic describing how frequency content varies over time.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Time-Frequency Property</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#TrendComponent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#DecompositionComponent"/>
    <skos:definition xml:lang="en">Long-term directional movement extracted from time series decomposition.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Trend Component</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/data-knowledge#TrendProperty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge#SegmentDataCharacteristic"/>
    <skos:definition xml:lang="en">Indicators of directionality or movement within data segments over time.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/data-knowledge"/>
    <skos:prefLabel xml:lang="en">Trend Property</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
