    <skos:definition xml:lang="en">The source requires the target as a prerequisite, input, or condition.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">requires</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source requires target.</skos:scopeNote>
  </rdf:Description>
