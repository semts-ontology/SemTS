    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Supersedes">
