    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Evidence"/>
    <skos:definition xml:lang="en">Evidence that confirms or supports an assumption or hypothesis.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Supporting Evidence</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Supports"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Supports">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#DirectedRelationship"/>
    <skos:definition xml:lang="en">The source provides evidence or justification for accepting the target.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">supports</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source supports target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#SystemReference">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#EntityReference"/>
    <skos:definition xml:lang="en">A reference to a system, subsystem, component, or asset.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">System Reference</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#TemporalConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Constraint"/>
    <skos:definition xml:lang="en">Constraint specifying timing requirements, durations, or sequencing rules.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Temporal Constraint</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#TemporalContext">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#ScenarioParameter"/>
    <skos:definition xml:lang="en">A parameter describing time-related context.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Temporal Context</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Threshold">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#ScenarioParameter"/>
    <skos:definition xml:lang="en">Boundary value used for conditions, alarms, or logic.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Threshold</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#ThresholdBreach">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Alert"/>
    <skos:definition xml:lang="en">Alert raised when a defined threshold is exceeded or violated.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Threshold Breach</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#ThresholdChange">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#ParameterChange"/>
    <skos:definition xml:lang="en">Parameter change adjusting a threshold used in control, alarms, or logic.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Threshold Change</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#TimeWindow">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#TemporalContext"/>
    <skos:definition xml:lang="en">A temporal interval relevant to the scenario.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Time Window</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Tolerance">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Reference"/>
    <skos:definition xml:lang="en">Acceptable deviation range from a reference value.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Tolerance</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#ToolWearState">
    <dct:isReplacedBy rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingToolWearState"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Status reflecting tool wear or condition.</skos:definition>
    <skos:historyNote xml:lang="en">Deprecated in version 1.3.0 in favour of the explicitly scoped concept of the manufacturing extension. Outside manufacturing, use the generic Wear State concept.</skos:historyNote>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Tool Wear State</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Triggers">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#DirectedRelationship"/>
    <skos:definition xml:lang="en">The source initiates the target when relevant conditions hold.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">triggers</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source triggers target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#TrigonometricEquation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#MathExpression"/>
    <skos:definition xml:lang="en">Trigonometric Equations use trigonometric functions to represent periodic patterns and cycles in time series data.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Trigonometric Equation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#UncategorizedEvent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Event"/>
    <skos:definition xml:lang="en">An event that is not predefined and thus an unexpected observation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Uncategorized Event</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#UncharacteristicObservation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Observation"/>
    <skos:definition xml:lang="en">Observed irregularity.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Uncharacteristic Observation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#UndirectedRelationship">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Relationship"/>
    <skos:definition xml:lang="en">A relationship concept whose participants are unordered.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Undirected Relationship</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Use with semts:UndirectedKnowledgeRelation.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#UnplannedDowntime">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#DowntimeEvent"/>
    <skos:definition xml:lang="en">Unscheduled outage or stop due to failure or other causes.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Unplanned Downtime</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Urgency">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Status"/>
    <skos:definition xml:lang="en">Time criticality of response.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Urgency</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#UserEvent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#CategorizedEvent"/>
    <skos:definition xml:lang="en">Event initiated by a user or operator.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">User Event</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Validates">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#DirectedRelationship"/>
    <skos:definition xml:lang="en">The source confirms the target against a criterion, procedure, or evidence base.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">validates</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source validates target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#ValidationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#CategorizedEvent"/>
    <skos:definition xml:lang="en">Event documenting the validation or verification of information or assumptions.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Validation Event</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#ValidationOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#ContextualDescription"/>
    <skos:definition xml:lang="en">Result or conclusion of a validation or verification process.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Validation Outcome</skos:prefLabel>
    <skos:related rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Validates"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#ValidationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Status"/>
    <skos:definition xml:lang="en">Status indicating the validation state of information (e.g., pending, validated, invalidated).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Validation Status</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#WearState">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Status"/>
    <skos:definition xml:lang="en">State describing accumulated wear or degradation of an entity.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Wear State</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#WorkInstruction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#Documentation"/>
    <skos:definition xml:lang="en">Prescriptive step-by-step instructions.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Work Instruction</skos:prefLabel>
  </rdf:Description>
