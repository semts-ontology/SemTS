    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#ContextualDescription"/>
    <skos:definition xml:lang="en">Known association or connection between entities, variables, or time series.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Relationship</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#Requirement">
