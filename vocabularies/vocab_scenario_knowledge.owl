    <skos:definition xml:lang="en">Action altering planned timing or sequence of activities.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">Reschedule</skos:prefLabel>
  </rdf:Description>
