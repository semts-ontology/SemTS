    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#DirectedRelationship"/>
    <skos:definition xml:lang="en">The source replaces the target as the currently preferred or valid assertion.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <skos:prefLabel xml:lang="en">supersedes</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Source supersedes target.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge#SupportingEvidence">
