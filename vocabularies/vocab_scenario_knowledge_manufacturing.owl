  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing">
    <dct:conformsTo rdf:resource="https://www.w3.org/TR/skos-reference/"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-06</dct:created>
    <dct:description xml:lang="en">A minimal example extension of the SemTS Scenario Knowledge vocabulary for genuinely manufacturing-specific meanings. Generic operational concepts remain in the scenario core. The module illustrates how a domain extends a core vocabulary. It is not a complete manufacturing vocabulary, and other domains are expected to publish their own extensions in the same way.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-18</dct:modified>
    <dct:references rdf:resource="https://w3id.org/semts/ontology#"/>
    <dct:title xml:lang="en">SemTS Manufacturing Scenario Knowledge Extension</dct:title>
    <vann:preferredNamespacePrefix>semts-msv</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <owl:imports rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge"/>
    <owl:versionInfo>1.3.0</owl:versionInfo>
    <skos:editorialNote xml:lang="en">The deprecated scenario concepts Production Cycle Start, Production Cycle Complete and Tool Wear State are declared in the Scenario Knowledge core, because their IRIs belong to that namespace.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingScenarioKnowledge"/>
    <skos:scopeNote xml:lang="en">The extension is not intended to be populated exhaustively. Terms are added only when a manufacturing-specific specialization contributes semantics beyond merely adding “manufacturing”, “production”, or a similar qualifier to a generic core concept.</skos:scopeNote>
    <adms:status rdf:resource="http://purl.org/adms/status/Completed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#MachineDowntime">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#DowntimeEvent"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingScenarioKnowledge"/>
    <skos:definition xml:lang="en">Downtime of a machine or machine subsystem.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing"/>
    <skos:prefLabel xml:lang="en">Machine Downtime</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A genuine manufacturing specialization because it constrains the affected entity to a machine.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingScenarioKnowledge">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#ScenarioKnowledge"/>
    <skos:definition xml:lang="en">Organizing concept for scenario-knowledge meanings that are genuinely specific to manufacturing.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing"/>
    <skos:prefLabel xml:lang="en">Manufacturing Scenario Knowledge</skos:prefLabel>
    <skos:scopeNote xml:lang="en">This extension is intentionally small. It demonstrates how domain-specific concepts can specialize the scenario core without mechanically prefixing or suffixing generic terms.</skos:scopeNote>
    <skos:topConceptOf rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingToolWearState">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://w3id.org/semts/ontology#KnowledgeConcept"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge#WearState"/>
    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingScenarioKnowledge"/>
    <skos:definition xml:lang="en">Wear state of a tool used in a manufacturing operation.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing"/>
    <skos:prefLabel xml:lang="en">Manufacturing Tool Wear State</skos:prefLabel>
    <skos:scopeNote xml:lang="en">A genuine manufacturing specialization because it constrains the worn entity and operational context.</skos:scopeNote>
  </rdf:Description>
