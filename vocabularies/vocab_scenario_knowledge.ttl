@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix semts: <https://w3id.org/semts/ontology#> .
@prefix semts-sv: <https://w3id.org/semts/vocabulary/scenario-knowledge#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# OWL declarations of the external terms used in this module, so that it is an OWL 2 DL document on its own.
# The SKOS terms are declared as in the SKOS RDF schema.
skos:Concept a owl:Class .
skos:ConceptScheme a owl:Class .
semts:KnowledgeConcept a owl:Class .
skos:broader a owl:ObjectProperty .
skos:hasTopConcept a owl:ObjectProperty .
skos:inScheme a owl:ObjectProperty .
skos:related a owl:ObjectProperty .
skos:relatedMatch a owl:ObjectProperty .
skos:topConceptOf a owl:ObjectProperty .
dct:conformsTo a owl:AnnotationProperty .
dct:created a owl:AnnotationProperty .
dct:description a owl:AnnotationProperty .
dct:isReplacedBy a owl:AnnotationProperty .
dct:license a owl:AnnotationProperty .
dct:modified a owl:AnnotationProperty .
dct:references a owl:AnnotationProperty .
dct:title a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .
skos:altLabel a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
skos:historyNote a owl:AnnotationProperty .
skos:prefLabel a owl:AnnotationProperty .
skos:scopeNote a owl:AnnotationProperty .
adms:status a owl:AnnotationProperty .

semts-sv:Acknowledgment a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Action ;
    skos:definition "Acknowledgment of an event."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Acknowledgment"@en .

semts-sv:AffectedEntity a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Entity or subject referenced by an event or annotation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Affected Entity"@en .

semts-sv:AgentReference a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:EntityReference ;
    skos:definition "A reference to a person, organization, device, or software agent."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Agent Reference"@en .

semts-sv:AlarmRule a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Rule ;
    skos:definition "Rule defining alarm conditions and logic."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Alarm Rule"@en .

semts-sv:AlgebraicEquation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MathExpression ;
    skos:definition "Algebraic Equations are mathematical statements consisting of algebraic expressions used in the analysis of time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Algebraic Equation"@en .

semts-sv:Approval a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Action ;
    skos:definition "Action of approving or accepting information, a plan, or a decision."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Approval"@en .

semts-sv:AssociatedWith a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:UndirectedRelationship ;
    skos:definition "The participants are contextually associated without a more specific relation being asserted."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "associated with"@en .

semts-sv:Baseline a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Reference ;
    skos:definition "Established normal behavior, typical value range, or reference state."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Baseline"@en .

semts-sv:BatchChangeover a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:SetupChangeover ;
    skos:definition "Setup changeover between batches or grouped work units. The involved domain is supplied by the associated context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Batch Changeover"@en .

semts-sv:BooleanEquation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MathExpression ;
    skos:definition "Boolean Equations involve logical operators and logical expressions."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Boolean Equation"@en .

semts-sv:BusinessEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Business-related event."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Business Event"@en .

semts-sv:CalendarEntry a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Annotation ;
    skos:definition "Calendar entries such as holidays, maintenance days."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Calendar Entry"@en .

semts-sv:CalibrationEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Event in which a measurement, model, instrument, or process is calibrated against a reference."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Calibration Event"@en .

semts-sv:CalibrationStatus a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Status ;
    skos:definition "Status describing whether and how an entity is calibrated relative to an applicable reference."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Calibration Status"@en .

semts-sv:CapabilityLimit a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Limit or capability threshold, such as control or specification limits."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Capability Limit"@en .

semts-sv:CausalFactor a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Description of a cause or influence relevant to a situation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Causal Factor"@en ;
    skos:related semts-sv:Causes .

semts-sv:CauseCode a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Parameter encoding root or primary cause category."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Cause Code"@en .

semts-sv:Certainty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Status ;
    skos:definition "A qualitative scenario status expressing how certain an assertion is. Quantitative confidence or uncertainty values should use the SemTS quality-measure vocabulary."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Certainty"@en .

semts-sv:CleaningEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MaintenanceEvent ;
    skos:definition "Cleaning activity that affects process or measurements."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Cleaning Event"@en .

semts-sv:CoOccursWith a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:UndirectedRelationship ;
    skos:definition "The participants occur together within a relevant temporal or contextual window."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "co-occurs with"@en .

semts-sv:Code a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Annotation ;
    skos:definition "Standardized code used for categorization, organization and indexing."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Code"@en .

semts-sv:CommunicationLoss a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Error ;
    skos:definition "Loss of communications or connectivity."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Communication Loss"@en .

semts-sv:ComplianceCheck a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Action ;
    skos:definition "Action to verify compliance with rules or standards."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Compliance Check"@en .

semts-sv:Conclusion a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Outcome or finding derived from analysis, reasoning, or validation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Conclusion"@en .

semts-sv:Condition a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:FormalDescription ;
    skos:definition "Boolean expressions used to evaluate conditions within time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Condition"@en .

semts-sv:Confirmation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Action ;
    skos:definition "Confirmation of previously unvalidated information."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Confirmation"@en .

semts-sv:ContradictingEvidence a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Evidence ;
    skos:definition "Evidence that contradicts or refutes an assumption or hypothesis."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Contradicting Evidence"@en ;
    skos:related semts-sv:Contradicts .

semts-sv:Contradiction a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Identified conflict or inconsistency between facts, assumptions, or observations."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Contradiction"@en ;
    skos:related semts-sv:ConflictsWith .

semts-sv:ContributesTo a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source is one contributing factor for the target but is not asserted to be sufficient by itself."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "contributes to"@en ;
    skos:scopeNote "Source contributes to target."@en .

semts-sv:ControlPlan a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Documentation ;
    skos:definition "Documented plan describing controls, checks, or interventions for an activity or system."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Control Plan"@en .

semts-sv:CorrectiveMaintenanceEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MaintenanceEvent ;
    skos:definition "Maintenance performed to correct detected issues or failures."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Corrective Maintenance Event"@en .

semts-sv:Correlation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Asserted Correlation"@en,
        "Correlation"@en ;
    skos:broader semts-sv:UndirectedRelationship ;
    skos:definition "A scenario assertion that two entities, states, events, or knowledge propositions covary or are correlated, without necessarily deriving the relation from the associated time-series data."@en ;
    skos:historyNote "In version 1.3.0 the preferred label changed from 'Correlation' to 'correlated with', following the verb-phrase labels of the other relationship concepts."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "correlated with"@en ;
    skos:relatedMatch <https://w3id.org/semts/vocabulary/data-knowledge#Correlation> .

semts-sv:CycleComplete a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:LifecycleEvent ;
    skos:definition "Event marking the completion of a recurring or otherwise bounded cycle in any domain."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Cycle Complete"@en .

semts-sv:CycleStart a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:LifecycleEvent ;
    skos:definition "Event marking the beginning of a recurring or otherwise bounded cycle in any domain."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Cycle Start"@en .

semts-sv:Deadline a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:TemporalContext ;
    skos:definition "A time by which a condition, action, or outcome is expected."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Deadline"@en .

semts-sv:Decision a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "A selected course of action or resolved choice."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Decision"@en .

semts-sv:DefectType a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Parameter categorizing defect types."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Defect Type"@en .

semts-sv:Dependency a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Dependency"@en ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "Relationship indicating that the source entity, process, or knowledge proposition requires or is contingent on the target."@en ;
    skos:historyNote "In version 1.3.0 the preferred label changed from 'Dependency' to 'depends on', following the verb-phrase labels of the other relationship concepts."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "depends on"@en ;
    skos:scopeNote "Source depends on target."@en .

semts-sv:DerivedFrom a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source knowledge is derived from the target knowledge or evidence."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "derived from"@en ;
    skos:scopeNote "Source is derived from target."@en .

semts-sv:DifferentialEquation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MathExpression ;
    skos:definition "Differential Equations involve derivatives and are used to model dynamic changes and trends in time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Differential Equation"@en .

semts-sv:DispatchInstruction a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Action ;
    skos:definition "Instruction to assign or route work, orders, or tasks."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Dispatch Instruction"@en .

semts-sv:DowntimeCategory a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Parameter categorizing downtime reasons or types."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Downtime Category"@en .

semts-sv:Duration a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:TemporalContext ;
    skos:definition "A temporal extent associated with a scenario entity or event."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Duration"@en .

semts-sv:Enables a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source creates a condition that makes the target possible."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "enables"@en ;
    skos:scopeNote "Source enables target."@en .

semts-sv:EnvironmentalCondition a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ExternalCondition ;
    skos:definition "Physical environmental factor such as temperature, humidity, or pressure affecting system behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Environmental Condition"@en .

semts-sv:EquivalentTo a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:UndirectedRelationship ;
    skos:definition "The participants are asserted to express equivalent meaning in the represented context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "equivalent to"@en .

semts-sv:ExpectedProfile a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Reference ;
    skos:definition "Expected temporal pattern or profile for a given context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Expected Profile"@en .

semts-sv:Explanation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Descriptive account clarifying why or how something occurred."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Explanation"@en ;
    skos:related semts-sv:Explains .

semts-sv:ExponentialEquation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MathExpression ;
    skos:definition "Exponential Equations model growth or decay processes in time series data using exponential functions."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Exponential Equation"@en .

semts-sv:ExternalEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Event originating outside the monitored system that affects observed behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "External Event"@en .

semts-sv:Forecast a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Forecast"@en ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "An externally supplied or expert-authored projection used as scenario context or a plan. Data-derived forecasts belong in the data knowledge vocabulary."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Scenario Forecast"@en .

semts-sv:Goal a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "A desired state or outcome relevant to the scenario."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Goal"@en .

semts-sv:Guideline a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Documentation ;
    skos:definition "Recommendation that helps to make decisions and ensures correct, consistent application."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Guideline"@en .

semts-sv:Hypothesis a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Assumption ;
    skos:definition "Proposed explanation or prediction explicitly subject to verification or testing."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Hypothesis"@en .

semts-sv:Inference a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Knowledge or conclusion derived through reasoning from other facts or observations."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Inference"@en .

semts-sv:InferredFact a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Fact ;
    skos:definition "Fact derived through logical inference rather than direct observation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Inferred Fact"@en .

semts-sv:InformalComment a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Note ;
    skos:definition "An informal note which can literally be any arbitrary message that is not covered by a predefined category."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Informal Comment"@en .

semts-sv:InspectionEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Action ;
    skos:definition "Inspection or quality check activity."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Inspection Event"@en .

semts-sv:IntegralEquation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:MathExpression ;
    skos:definition "Integral Equations involve integrals and are used to analyze cumulative effects and total values in time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Integral Equation"@en .

semts-sv:Involvement a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Annotation ;
    skos:definition "Annotation describing participation or role of an actor or entity."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Involvement"@en .

semts-sv:Justification a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Reasoning or explanation supporting a decision, conclusion, or annotation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Justification"@en .

semts-sv:Keyword a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Annotation ;
    skos:definition "Free-form tag used for categorization, organization and indexing."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Keyword"@en .

semts-sv:Label a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Annotation ;
    skos:definition "Labels are identifiers or markers added to time series data to categorize or highlight specific elements or features."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Label"@en .

semts-sv:Location a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Annotation ;
    skos:definition "Location associated with data, events, or entities."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Location"@en .

