    skos:definition "Assumptions are hypotheses or premises considered within the context of analyzing time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Assumption"@en .

semts-sv:Causes a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source produces or brings about the target under the represented context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "causes"@en ;
    skos:relatedMatch <https://w3id.org/semts/vocabulary/data-knowledge#Causality> ;
    skos:scopeNote "Source causes target."@en .

semts-sv:ConflictsWith a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:UndirectedRelationship ;
    skos:definition "The participants cannot simultaneously hold, comply, or apply under the represented context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "conflicts with"@en .

semts-sv:Contradicts a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source conflicts with or provides evidence against the target."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "contradicts"@en ;
    skos:scopeNote "Source contradicts target."@en .

semts-sv:Deployment a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Deployment activity."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Deployment"@en .

semts-sv:Explains a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source provides an explanation for the target."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "explains"@en ;
    skos:scopeNote "Source explains target."@en .

semts-sv:ExternalCondition a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "External factor or condition outside the monitored system that influences observed behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "External Condition"@en .

semts-sv:Fact a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Evaluated statement that holds true and equals ground truth information."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Fact"@en .

semts-sv:Note a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Notes are brief pieces of information that are added to time series data to highlight important aspects or observations."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Note"@en .

semts-sv:Observation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:UncategorizedEvent ;
    skos:definition "Observations are specific perceptions made based on time series behaviors."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Observation"@en .

semts-sv:Plan a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Documentation ;
    skos:definition "Documented intended course of action specifying what should occur."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Plan"@en .

semts-sv:SetupChangeover a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Event in which an entity or activity changes from one setup or configuration to another."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Setup Changeover"@en .

semts-sv:Supports a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source provides evidence or justification for accepting the target."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "supports"@en ;
    skos:scopeNote "Source supports target."@en .

semts-sv:UncategorizedEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Event ;
    skos:definition "An event that is not predefined and thus an unexpected observation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Uncategorized Event"@en .

semts-sv:Validates a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:DirectedRelationship ;
    skos:definition "The source confirms the target against a criterion, procedure, or evidence base."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "validates"@en ;
    skos:scopeNote "Source validates target."@en .

semts-sv:Constraint a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Rule ;
    skos:definition "Restriction or limitation governing system behavior or valid operating ranges."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Constraint"@en .

semts-sv:DowntimeEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "An event or interval in which an entity, service, system, process, or activity is unavailable or not operating as intended."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Downtime Event"@en ;
    skos:scopeNote "Domain-neutral concept. A domain extension may define narrower concepts such as machine downtime."@en .

semts-sv:Event a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioKnowledge ;
    skos:definition "A specific occurrence or incident."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Event"@en .

semts-sv:Evidence a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Information or data supporting or refuting an assumption, hypothesis, or conclusion."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Evidence"@en .

semts-sv:FormalDescription a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Formal Description provides formally defined background or situational details that enhance the understanding of time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Formal Description"@en .

semts-sv:Relationship a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Known association or connection between entities, variables, or time series."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Relationship"@en .

semts-sv:Alert a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "User-facing notification about conditions or events affecting service or entities."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Alert"@en .

semts-sv:Error a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Identified malfunction."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Error"@en .

semts-sv:ParameterChange a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Action/event indicating modification of one or more Scenario Parameters."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Parameter Change"@en .

semts-sv:Reference a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Expected value, behavior, or profile against which observations are compared."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Reference"@en .

semts-sv:EntityReference a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "A parameter that identifies or refers to an entity relevant to the scenario."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Entity Reference"@en .

semts-sv:Rule a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Information which can be regarded a restriction or instruction."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Rule"@en .

semts-sv:TemporalContext a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "A parameter describing time-related context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Temporal Context"@en .

semts-sv:LifecycleEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Event marking activity lifecycle transitions such as start, complete, suspend, or resume."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Lifecycle Event"@en .

semts-sv:ScenarioKnowledge a skos:Concept,
        semts:KnowledgeConcept ;
    skos:definition "Scenario Knowledge encompasses structured information and insights relevant to understanding and analyzing specific situations in time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Scenario Knowledge"@en ;
    skos:topConceptOf <https://w3id.org/semts/vocabulary/scenario-knowledge> .

semts-sv:Documentation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ContextualDescription ;
    skos:definition "Description of a procedure or process."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Documentation"@en .

semts-sv:MaintenanceEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "Event documenting scheduled or unscheduled maintenance activities for assets or devices."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Maintenance Event"@en .

semts-sv:Status a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioParameter ;
    skos:definition "Categorical or ordinal state of an entity, device, process, service, or event at a point in time (e.g., active/inactive, open/closed, enabled/disabled, acknowledged/unacknowledged)."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Status"@en .

semts-sv:UndirectedRelationship a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Relationship ;
    skos:definition "A relationship concept whose participants are unordered."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Undirected Relationship"@en ;
    skos:scopeNote "Use with semts:UndirectedKnowledgeRelation."@en .

semts-sv:Annotation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioKnowledge ;
    skos:definition "Annotations are labels added to time series data to provide validated context or information for better understanding."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Annotation"@en .

semts-sv:MathExpression a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:FormalDescription ;
    skos:definition "Math Expressions are mathematical formulas or equations used to model or analyze time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Math Expression"@en .

semts-sv:Action a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:CategorizedEvent ;
    skos:definition "An action that equals a predefined event. Commonly performed to change or correct a certain process behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Action"@en .

semts-sv:CategorizedEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Event ;
    skos:definition "An event that is predefined and not an unexpected observation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Categorized Event"@en .

semts-sv:DirectedRelationship a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:Relationship ;
    skos:definition "A relationship concept whose meaning is interpreted from relation source to relation target."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Directed Relationship"@en ;
    skos:scopeNote "Use with semts:DirectedKnowledgeRelation. The source-to-target orientation follows the concept definition."@en .

semts-sv:ScenarioParameter a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioKnowledge ;
    skos:definition "Scenario Parameters are variables related to specific scenarios."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Scenario Parameter"@en .

semts-sv:ContextualDescription a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-sv:ScenarioKnowledge ;
    skos:definition "Contextual description provides background or situational details that enhance the understanding of time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Contextual Description"@en .

semts-sv:ProductionCycleComplete a skos:Concept,
        semts:KnowledgeConcept ;
    dct:isReplacedBy semts-sv:CycleComplete ;
    owl:deprecated true ;
    skos:definition "Completion of a production cycle."@en ;
    skos:historyNote "Deprecated in version 1.3.0 because the generic Cycle Complete concept already expresses the required semantics. State the manufacturing context through associated knowledge or entities."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Production Cycle Complete"@en .

semts-sv:ProductionCycleStart a skos:Concept,
        semts:KnowledgeConcept ;
    dct:isReplacedBy semts-sv:CycleStart ;
    owl:deprecated true ;
    skos:definition "Start of a production cycle."@en ;
    skos:historyNote "Deprecated in version 1.3.0 because the generic Cycle Start concept already expresses the required semantics. State the manufacturing context through associated knowledge or entities."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Production Cycle Start"@en .

semts-sv:ToolWearState a skos:Concept,
        semts:KnowledgeConcept ;
    dct:isReplacedBy <https://w3id.org/semts/vocabulary/scenario-knowledge/manufacturing#ManufacturingToolWearState> ;
    owl:deprecated true ;
    skos:definition "Status reflecting tool wear or condition."@en ;
    skos:historyNote "Deprecated in version 1.3.0 in favour of the explicitly scoped concept of the manufacturing extension. Outside manufacturing, use the generic Wear State concept."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/scenario-knowledge> ;
    skos:prefLabel "Tool Wear State"@en .

<https://w3id.org/semts/vocabulary/scenario-knowledge> a owl:Ontology,
        skos:ConceptScheme ;
    dct:conformsTo <https://www.w3.org/TR/skos-reference/> ;
    dct:created "2025-04-25"^^xsd:date ;
    dct:description "A domain-neutral SKOS vocabulary for scenario knowledge associated directly or indirectly with time-series data, including annotations, contextual descriptions, events, parameters, and relation meanings. Domain extensions add only genuinely narrower concepts."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-18"^^xsd:date ;
    dct:references <https://github.com/semts-ontology/SemTS>,
        semts: ;
    dct:title "SemTS Scenario Knowledge Vocabulary"@en ;
    vann:preferredNamespacePrefix "semts-sv" ;
    vann:preferredNamespaceUri "https://w3id.org/semts/vocabulary/scenario-knowledge#" ;
    owl:versionInfo "1.3.0" ;
    skos:hasTopConcept semts-sv:ScenarioKnowledge ;
    skos:scopeNote "The active core avoids domain-qualified variants when a generic concept is sufficient. For example, Cycle Start and Cycle Complete are domain-neutral. A domain extension should add a narrower term only when it contributes additional meaning beyond a prefix or suffix."@en ;
    adms:status <http://purl.org/adms/status/Completed> .

