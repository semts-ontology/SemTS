@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix semts: <https://w3id.org/semts/ontology#> .
@prefix semts-dv: <https://w3id.org/semts/vocabulary/data-knowledge#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# OWL declarations of the external terms used in this module, so that it is an OWL 2 DL document on its own.
# The SKOS terms are declared as in the SKOS RDF schema.
skos:Concept a owl:Class .
skos:ConceptScheme a owl:Class .
semts:KnowledgeConcept a owl:Class .
skos:broader a owl:ObjectProperty .
skos:hasTopConcept a owl:ObjectProperty .
skos:inScheme a owl:ObjectProperty .
skos:related a owl:ObjectProperty .
skos:relatedMatch a owl:ObjectProperty .
skos:topConceptOf a owl:ObjectProperty .
dct:conformsTo a owl:AnnotationProperty .
dct:created a owl:AnnotationProperty .
dct:description a owl:AnnotationProperty .
dct:license a owl:AnnotationProperty .
dct:modified a owl:AnnotationProperty .
dct:references a owl:AnnotationProperty .
dct:title a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .
skos:altLabel a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
skos:editorialNote a owl:AnnotationProperty .
skos:prefLabel a owl:AnnotationProperty .
skos:scopeNote a owl:AnnotationProperty .
adms:status a owl:AnnotationProperty .

semts-dv:Anomaly a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Knowledge asserting that a data point, interval, segment, or group deviates from an expected reference or pattern."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Anomaly"@en .

semts-dv:AssociationRule a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "A conditional association between patterns, events, states, or knowledge propositions."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Association Rule"@en ;
    skos:scopeNote "When represented as a directed relation, source is the antecedent and target is the consequent."@en .

semts-dv:CausalGraph a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:RelationStructure ;
    skos:definition "Network representation of causal relationships between time series variables."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Causal Graph"@en .

semts-dv:CausalInfluence a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Causality ;
    skos:definition "A directional influence whose intervention or change can affect a target."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Causal Influence"@en ;
    skos:scopeNote "Source causally influences target."@en .

semts-dv:CauseEffectDependency a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Causality ;
    skos:definition "A causal dependency in which a source contributes to or determines an effect at a target."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Cause-Effect Dependency"@en ;
    skos:scopeNote "Source is represented as a cause of, or causal contributor to, target."@en .

semts-dv:ChangeProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic describing increments, differences, variation, or change intensity over time."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Change Property"@en .

semts-dv:ClassMembership a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:InferredAnnotation ;
    skos:definition "A class or category membership assigned to a segment or knowledge item."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Class Membership"@en .

semts-dv:Classification a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Classification"@en ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Knowledge assigning one or more class labels to a segment, dimension, or group of segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Classification Result"@en ;
    skos:related semts-dv:InferredClassID .

semts-dv:ClusterMembership a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:InferredAnnotation ;
    skos:definition "Membership of a segment or knowledge item in a cluster."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Cluster Membership"@en .

semts-dv:Clustering a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Clustering"@en ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "Knowledge describing a grouping of segments or observations obtained by a clustering method."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Clustering Result"@en ;
    skos:related semts-dv:Cluster .

semts-dv:Coherence a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Correlation ;
    skos:definition "Frequency-specific correlation measure between time series indicating synchronized behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Coherence"@en .

semts-dv:ComplexityProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic describing regularity, entropy, compressibility, or dynamical complexity."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Complexity Property"@en .

semts-dv:ConceptDrift a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Change in the underlying data-generating process affecting model performance over time."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Concept Drift"@en .

semts-dv:ConfidenceInterval a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ProbabilisticForecast ;
    skos:definition "Statistical interval around point forecasts indicating parameter uncertainty."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Confidence Interval"@en .

semts-dv:CounterfactualPrediction a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataLevelPrediction ;
    skos:definition "Predicted outcomes under hypothetical scenarios that did not actually occur."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Counterfactual Prediction"@en .

semts-dv:CrossSpectralDensity a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "Frequency domain representation of relationships between multiple time series."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Cross-Spectral Density"@en .

semts-dv:CyclicalComponent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DecompositionComponent ;
    skos:definition "Longer-term cyclical patterns distinct from regular seasonality."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Cyclical Component"@en .

semts-dv:DTWDistance a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Distance ;
    skos:definition "Dynamic Time Warping distance between sequences."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "DTW Distance"@en .

semts-dv:DataInformationProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "General informational attributes of data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Data Information Property"@en .

semts-dv:DetectedEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "An event occurrence inferred from time-series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Detected Event"@en .

semts-dv:DirectCausalEffect a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Causality ;
    skos:definition "A causal effect not mediated by another represented cause-effect step."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Direct Causal Effect"@en ;
    skos:scopeNote "Source has a direct causal effect on target."@en .

semts-dv:DispersionProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Measures of the spread or variability within data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Dispersion Property"@en .

semts-dv:DistributionShapeProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic describing the shape of the value distribution."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Distribution Shape Property"@en .

semts-dv:Embedding a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:RepresentationCharacteristic ;
    skos:definition "A vector or structured representation of a segment or knowledge item in a representation space."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Embedding"@en .

semts-dv:EventIntensityForecast a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataLevelPrediction ;
    skos:definition "Forecasted event intensity over time."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Event Intensity Forecast"@en .

semts-dv:ExtremumProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic describing minimum, maximum, or extreme values and their positions."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Extremum Property"@en .

semts-dv:FeatureImportance a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:InferredAnnotation ;
    skos:definition "Attribution of a model’s prediction to input features or time steps."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Feature Importance"@en .

semts-dv:FeatureVector a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:RepresentationCharacteristic ;
    skos:definition "An ordered vector of extracted characteristics associated with a segment or group."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Feature Vector"@en .

semts-dv:Forecast a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataLevelPrediction ;
    skos:definition "Predicted future values or trajectories associated with a time-series segment or continuation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Forecast"@en .

semts-dv:FrequencyDomainProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic derived from a frequency-domain or spectral representation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Frequency-Domain Property"@en .

semts-dv:HiddenStateSequence a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:InferredAnnotation ;
    skos:definition "Inferred latent states from Hidden Markov Models or similar probabilistic approaches."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Hidden State Sequence"@en .

semts-dv:Imputation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataLevelPrediction ;
    skos:definition "Estimated values supplied for missing or invalid observations in a time series."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Imputation"@en .

semts-dv:IndirectCausalEffect a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Causality ;
    skos:definition "A causal effect mediated by one or more intermediate entities or relations."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Indirect Causal Effect"@en ;
    skos:scopeNote "Source has an indirect causal effect on target through one or more mediators."@en .

semts-dv:InterventionEffect a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Causality ;
    skos:definition "Quantified impact of external interventions on time series behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Intervention Effect"@en .

semts-dv:LocationProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Properties that define the position or location within data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Location Property"@en .

semts-dv:MagnitudeProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic describing the overall magnitude or energy of values."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Magnitude Property"@en .

semts-dv:Medoid a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentGroupRepresentative ;
    skos:definition "An observed group member selected as the representative with minimal aggregate distance to other members."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Medoid"@en .

semts-dv:ModelUncertainty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ProbabilisticForecast ;
    skos:definition "Epistemic uncertainty arising from incomplete knowledge of model parameters."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Model Uncertainty"@en .

semts-dv:Motif a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Motif Collection"@en ;
    skos:broader semts-dv:SegmentGroup ;
    skos:definition "A collection of motifs instances within time series data, representing a frequently occurring pattern that provides insights into underlying processes."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Motif Group"@en ;
    skos:related semts-dv:MotifElement .

semts-dv:NecessaryConditionRelation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ConditionRelation ;
    skos:definition "A causal or logical relation in which the target cannot occur without the source condition."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Necessary Condition Relation"@en ;
    skos:scopeNote "Source is a necessary condition for target."@en .

semts-dv:OutOfDistribution a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Detection of inputs outside the training distribution."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Out-of-Distribution (OOD) Detection"@en .

semts-dv:Pattern a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Pattern"@en ;
    skos:broader semts-dv:SegmentGroup ;
    skos:definition "Group of repeating data segments with the same or similar behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Pattern Group"@en ;
    skos:related semts-dv:PatternElement .

semts-dv:PeriodicityProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A characteristic describing repeated, seasonal, cyclic, or periodic behavior."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Periodicity Property"@en .

semts-dv:PredictedEvent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Prediction of an event or action."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Predicted Event"@en .

semts-dv:PredictionInterval a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ProbabilisticForecast ;
    skos:definition "An interval quantifying forecast uncertainty at a given coverage level (e.g., 90%)."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Prediction Interval"@en .

semts-dv:Prototype a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentGroupRepresentative ;
    skos:definition "A representative constructed to summarize a group of segments or knowledge items."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Prototype"@en .

semts-dv:QuantileForecast a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ProbabilisticForecast ;
    skos:definition "Forecast expressed by one or more quantiles (e.g., 0.1, 0.5, 0.9)."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Quantile Forecast"@en .

semts-dv:RegimeChange a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:Changepoint ;
    skos:definition "Detection of transitions between different operational regimes in time series."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Regime Change"@en .

semts-dv:RegimeDetection a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Identification of different operational states or regimes within time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Regime Detection"@en .

semts-dv:ResidualComponent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DecompositionComponent ;
    skos:definition "Remaining variation after trend and seasonal components are removed from decomposition."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Residual Component"@en .

semts-dv:SeasonalComponent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DecompositionComponent ;
    skos:definition "Extracted seasonal patterns from time series decomposition."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Seasonal Component"@en .

semts-dv:Segmentation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Segmentation"@en ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "Knowledge describing a partition or boundary structure over a time series."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Segmentation Result"@en ;
    skos:related semts-dv:SegmentGroupRepresentative .

semts-dv:Shapelet a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentGroupRepresentative ;
    skos:definition "A characteristic subseries or pattern within a time series that is useful for classification."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Shapelet"@en .

semts-dv:Similarity a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "A quantified or qualified resemblance relation between segments, values, representations, or knowledge items."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Similarity"@en ;
    skos:scopeNote "Use as the concept of a semts:SegmentRelation that is attached to two or more segments through semts:multiSegmentKnowledge, or of a semts:UndirectedKnowledgeRelation when the similarity holds between knowledge items. Per-segment similarity features (for example query similarity counts) are segment data characteristics, not relations."@en .

semts-dv:StateEstimate a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "An inferred latent or observable state associated with a segment."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "State Estimate"@en .

semts-dv:StructuralProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Attributes related to the composition or arrangement of data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Structural Property"@en .

semts-dv:SufficientConditionRelation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ConditionRelation ;
    skos:definition "A causal or logical relation in which the source condition is sufficient for the target under the stated context."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Sufficient Condition Relation"@en ;
    skos:scopeNote "Source is a sufficient condition for target under the represented context."@en .

semts-dv:TemporalDependenceProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Characteristic describing dependence between observations of the same time series across temporal offsets."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Temporal Dependence Property"@en .

semts-dv:TemporalPointProcess a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:ModelInstance ;
    skos:definition "A stochastic process modeling discrete events in time via an intensity function."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Temporal Point Process"@en .

semts-dv:TimeFrequencyProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Characteristic describing how frequency content varies over time."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Time-Frequency Property"@en .

semts-dv:TrendComponent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DecompositionComponent ;
    skos:definition "Long-term directional movement extracted from time series decomposition."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Trend Component"@en .

semts-dv:TrendProperty a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Indicators of directionality or movement within data segments over time."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Trend Property"@en .

semts-dv:Changepoint a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Detection of shifts or changes in the underlying dynamics of data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Changepoint"@en .

semts-dv:Cluster a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentGroup ;
    skos:definition "A cluster represents one group from a clustering, characterized by shared properties."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Cluster"@en ;
    skos:related semts-dv:SegmentGroupRepresentative .

semts-dv:Correlation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "A statistical dependence relation between values, dimensions, segments, or knowledge items."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Correlation"@en ;
    skos:relatedMatch <https://w3id.org/semts/vocabulary/scenario-knowledge#Correlation> ;
    skos:scopeNote "Use as the concept of a semts:SegmentRelation that is attached to two or more segments through semts:multiSegmentKnowledge, or of a semts:UndirectedKnowledgeRelation when the correlation holds between knowledge items, unless a directional statistical relation is explicitly intended. A correlation that is asserted by an expert rather than derived from the data is scenario knowledge (semts-sv:Correlation)."@en .

semts-dv:Distance a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "A quantified dissimilarity between segments, values, representations, or knowledge items."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Distance"@en ;
    skos:scopeNote "Use as the concept of a semts:SegmentRelation that is attached to two or more segments through semts:multiSegmentKnowledge, or of a semts:UndirectedKnowledgeRelation when the distance measure is symmetric. Asymmetric distances require a semts:DirectedKnowledgeRelation with an explicit source-to-target interpretation."@en .

semts-dv:InferredClassID a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:InferredAnnotation ;
    skos:definition "A classification identifier derived from analysis and inference."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Inferred Class ID"@en .

semts-dv:ModelInstance a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataKnowledge ;
    skos:definition "A model generated via machine learning."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Model Instance"@en .

semts-dv:MotifElement a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:PatternElement ;
    skos:definition "A segment identified as an occurrence of a motif, modeled as a specialized pattern element."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Motif Element"@en .

semts-dv:RelationStructure a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "Structured representation of multiple relations among segments, variables, or knowledge entities."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Relation Structure"@en .

semts-dv:ConditionRelation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "Relation expressing a necessary or sufficient condition without implying physical causation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Condition Relation"@en .

semts-dv:PatternElement a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "A segment identified as an occurrence or member of a repeated or otherwise characteristic pattern."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Pattern Element"@en .

semts-dv:RepresentationCharacteristic a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "A learned or constructed representation of a segment, dimension, or group."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Representation Characteristic"@en .

semts-dv:SegmentPrediction a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataKnowledge ;
    skos:definition "Knowledge related to predicting outcomes or future trends within data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Segment Prediction"@en .

semts-dv:SegmentGroup a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "A collection of related segments within time series data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Segment Group"@en .

semts-dv:DecompositionComponent a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Component obtained by decomposing a time series into interpretable constituent parts."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Decomposition Component"@en .

semts-dv:ProbabilisticForecast a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataLevelPrediction ;
    skos:definition "A forecast represented as a probability distribution over future values, including quantiles or prediction intervals."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Probabilistic Forecast"@en .

semts-dv:Causality a skos:Concept,
        semts:KnowledgeConcept ;
    skos:altLabel "Causality"@en ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "A directed cause-effect relation inferred or estimated between segments, variables, events, or knowledge propositions. It is stronger than mere correlation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Causal Relation"@en ;
    skos:relatedMatch <https://w3id.org/semts/vocabulary/scenario-knowledge#Causes> ;
    skos:scopeNote "Use with semts:DirectedKnowledgeRelation when the source-to-target causal orientation is represented explicitly."@en .

semts-dv:DataKnowledge a skos:Concept,
        semts:KnowledgeConcept ;
    skos:definition "A comprehensive category encompassing various forms of knowledge derived from data analysis."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Data Knowledge"@en ;
    skos:topConceptOf <https://w3id.org/semts/vocabulary/data-knowledge> .

semts-dv:DataLevelPrediction a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentPrediction ;
    skos:definition "Knowledge involving the generation of data inferred from existing data."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Data Level Prediction"@en .

semts-dv:InferredAnnotation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:AnnotationLevelPrediction ;
    skos:definition "Annotations derived from analysis that highlight inferred knowledge or insights."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Inferred Annotation"@en .

semts-dv:SegmentGroupRepresentative a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentRelation ;
    skos:definition "An entity that acts as a typical example or reference for a group of segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Segment Group Representative"@en .

semts-dv:AnnotationLevelPrediction a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentPrediction ;
    skos:definition "Knowledge that enriches existing records by attaching labels or classes about outcomes such as events and anomalies."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Annotation Level Prediction"@en .

semts-dv:SegmentRelation a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataKnowledge ;
    skos:definition "Relationships and connections between different data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Segment Relation"@en .

semts-dv:SegmentDataCharacteristic a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:DataKnowledge ;
    skos:definition "Attributes and features that define specific data segments."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge> ;
    skos:prefLabel "Segment Data Characteristic"@en .

<https://w3id.org/semts/vocabulary/data-knowledge> a owl:Ontology,
        skos:ConceptScheme ;
    dct:conformsTo <https://www.w3.org/TR/skos-reference/> ;
    dct:created "2025-04-25"^^xsd:date ;
    dct:description "A stable, domain-neutral SKOS core for knowledge derived from time-series data. Concrete feature concepts are structurally separated into a default-imported feature extension."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-18"^^xsd:date ;
    dct:references <https://github.com/semts-ontology/SemTS>,
        semts: ;
    dct:title "SemTS Data Knowledge Vocabulary"@en ;
    vann:preferredNamespacePrefix "semts-dv" ;
    vann:preferredNamespaceUri "https://w3id.org/semts/vocabulary/data-knowledge#" ;
    owl:imports <https://semts-ontology.github.io/SemTS/vocabularies/vocab_data_knowledge_feature_extension.owl> ;
    owl:versionInfo "1.3.0" ;
    skos:hasTopConcept semts-dv:DataKnowledge ;
    skos:scopeNote "The core contains stable result categories, prediction meanings, relation meanings, model artifacts, representation results, and decomposition components. It does not duplicate concrete features declared in the imported feature extension."@en ;
    skos:editorialNote "Concept IRIs published in version 1.2.0 of this vocabulary keep their semts-dv IRIs, including the concrete features that moved to the feature extension. Concepts added after 1.2.0 to the extension use the semts-dfx namespace."@en ;
    adms:status <http://purl.org/adms/status/Completed> .

