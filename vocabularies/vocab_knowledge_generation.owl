    <skos:broader rdf:resource="https://w3id.org/semts/vocabulary/knowledge-generation#ComparisonBasedGeneration"/>
    <skos:definition xml:lang="en">Comparison of a value or knowledge item with a threshold or rule boundary.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/semts/vocabulary/knowledge-generation"/>
    <skos:prefLabel xml:lang="en">Threshold Comparison</skos:prefLabel>
