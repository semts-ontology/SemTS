semts-dv:DominantFrequency a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:FrequencyDomainProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Primary frequency components that characterize the time series in the frequency domain."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Dominant Frequency"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:EnergyRatioByChunks a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.energy_ratio_by_chunks> ;
    skos:broader semts-dv:StructuralProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Sum of squares in a chunk as a ratio of total sum of squares over the series."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
