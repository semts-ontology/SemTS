@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semts: <https://w3id.org/semts/ontology#> .
@prefix semts-dfx: <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#> .
@prefix semts-dv: <https://w3id.org/semts/vocabulary/data-knowledge#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# OWL declarations of the external terms used in this module, so that it is an OWL 2 DL document on its own.
# The SKOS terms are declared as in the SKOS RDF schema.
skos:Concept a owl:Class .
skos:ConceptScheme a owl:Class .
semts:KnowledgeConcept a owl:Class .
skos:broader a owl:ObjectProperty .
skos:hasTopConcept a owl:ObjectProperty .
skos:inScheme a owl:ObjectProperty .
skos:topConceptOf a owl:ObjectProperty .
dct:conformsTo a owl:AnnotationProperty .
dct:created a owl:AnnotationProperty .
dct:description a owl:AnnotationProperty .
dct:isPartOf a owl:AnnotationProperty .
dct:license a owl:AnnotationProperty .
dct:modified a owl:AnnotationProperty .
dct:references a owl:AnnotationProperty .
dct:title a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
skos:editorialNote a owl:AnnotationProperty .
skos:prefLabel a owl:AnnotationProperty .
skos:scopeNote a owl:AnnotationProperty .
adms:status a owl:AnnotationProperty .

semts-dv:ARCoefficient a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.ar_coefficient> ;
    skos:broader semts-dv:TemporalDependenceProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Coefficients from unconditional MLE fit of an AR(k) process."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "AR coefficient"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:AbsEnergy a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.abs_energy> ;
    skos:broader semts-dv:MagnitudeProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Sum over squared values of the time series (absolute energy)."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Absolute energy"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:AbsoluteMaximumValue a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.absolute_maximum> ;
    skos:broader semts-dv:ExtremumProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Highest absolute value of the time series."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Absolute maximum value"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:AbsoluteSumOfChanges a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.absolute_sum_of_changes> ;
    skos:broader semts-dv:ChangeProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Sum of absolute consecutive changes in the series."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Absolute sum of changes"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:AggAutocorrelation a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.agg_autocorrelation> ;
    skos:broader semts-dv:TemporalDependenceProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Descriptive statistics over the autocorrelation function of the time series."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Aggregated autocorrelation"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:AggLinearTrend a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.agg_linear_trend> ;
    skos:broader semts-dv:TrendProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Linear regression on chunk-aggregated values versus chunk index."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Aggregated linear trend"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:ApproximateEntropy a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.approximate_entropy> ;
    skos:broader semts-dv:ComplexityProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Vectorized approximate entropy of the time series."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Approximate entropy"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:AugmentedDickeyFuller a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.augmented_dickey_fuller> ;
    skos:broader semts-dv:StructuralProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Test statistic assessing presence of a unit root (stationarity test)."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Augmented Dickey-Fuller"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:Autocorrelation a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.autocorrelation> ;
    skos:broader semts-dv:TemporalDependenceProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Autocorrelation at a specified lag."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Autocorrelation (lag)"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

semts-dv:BenfordCorrelation a skos:Concept,
        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.benford_correlation> ;
    skos:broader semts-dv:DistributionShapeProperty,
        semts-dfx:DetailedTimeSeriesFeature ;
    skos:definition "Correlation with the first-digit distribution under Benford's law (useful for anomaly detection)."@en ;
    skos:editorialNote "Illustrative mapping to a tsfresh feature calculator. The SemTS concept is not restricted to that implementation."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Benford correlation"@en ;
    skos:scopeNote "Concrete feature concept maintained only in the default-imported SemTS data-feature extension. Its semantic family is defined in the Data Knowledge core."@en .

