    skos:prefLabel "Linear trend statistic"@en ;
    skos:scopeNote "Use semts-dv:LinearSlope and semts-dv:LinearIntercept for those two statistics. For the p-value, r value and standard error, use this concept and name the statistic in semts:title."@en .

semts-dfx:DetailedTimeSeriesFeature a skos:Concept,
        semts:KnowledgeConcept ;
    skos:broader semts-dv:SegmentDataCharacteristic ;
    skos:definition "Organizing concept for concrete time-series characteristics and feature results maintained outside the stable Data Knowledge core."@en ;
    skos:inScheme <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> ;
    skos:prefLabel "Detailed Time-Series Feature"@en ;
    skos:scopeNote "This extension is imported by the Data Knowledge core. Concrete features occur only in this file, while their stable semantic families remain in the core."@en ;
    skos:topConceptOf <https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> .

<https://w3id.org/semts/vocabulary/data-knowledge/feature-extension> a owl:Ontology,
        skos:ConceptScheme ;
    dct:conformsTo <https://www.w3.org/TR/skos-reference/> ;
    dct:created "2026-08-06"^^xsd:date ;
    dct:description "Default-imported extension containing concrete time-series feature meanings, including general summary features and tsfresh-aligned feature calculators. Stable semantic families remain in the Data Knowledge core. The catalogue is an example of a feature extension, aligned with one feature library. It is neither complete nor normative, and further feature catalogues can extend the core in the same way."@en ;
    dct:isPartOf <https://w3id.org/semts/vocabulary/data-knowledge> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-11-18"^^xsd:date ;
    dct:references <https://tsfresh.readthedocs.io/en/latest/>,
        semts: ;
    dct:title "SemTS Data Feature Catalogue Extension"@en ;
    vann:preferredNamespacePrefix "semts-dfx" ;
    vann:preferredNamespaceUri "https://w3id.org/semts/vocabulary/data-knowledge/feature-extension#" ;
    owl:versionInfo "1.3.0" ;
    skos:hasTopConcept semts-dfx:DetailedTimeSeriesFeature ;
    skos:scopeNote "The extension is structurally separate but included by default through owl:imports from the Data Knowledge core. Feature concepts are not duplicated in the core file."@en ;
    skos:editorialNote "Namespace policy: features published in version 1.2.0 of the Data Knowledge vocabulary keep their semts-dv IRIs so that existing data stays valid. Features added later use the semts-dfx namespace of this extension."@en ;
    adms:status <http://purl.org/adms/status/Completed> .

