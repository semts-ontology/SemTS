        semts:KnowledgeConcept ;
    rdfs:seeAlso <https://tsfresh.readthedocs.io/en/latest/api/tsfresh.feature_extraction.html#tsfresh.feature_extraction.feature_calculators.binned_entropy> ;
    skos:broader semts-dv:ComplexityProperty,
